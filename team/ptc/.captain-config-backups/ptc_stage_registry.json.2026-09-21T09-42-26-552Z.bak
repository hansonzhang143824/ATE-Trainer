{
  "schemaVersion": 1,
  "project": "DALI",
  "entrypoint": "scripts/ate_ptc_batch_runner.py",
  "stateMachine": ["INPUT_SYNC", "STRATEGY", "METHOD", "RULE_REVIEW_METHOD", "IMPLEMENTATION", "RULE_REVIEW_IMPLEMENTATION", "COMPILE", "COMPLETE"],
  "stages": {
    "INPUT_SYNC": {"owner": "captain", "gate": "scripts/prepare_input_sync_v2.py", "families": ["all"], "outputs": ["input-manifest.json"]},
    "STRATEGY": {"owner": "test-strategy-architect", "gate": "scripts/validate_strategy_contract.py", "families": ["all"], "outputs": ["strategy/*-resource-config-contract.json", "strategy/deliverable-ready.json"]},
    "METHOD": {"owner": "test-method-expert", "gate": "scripts/validate_method_contract.py", "families": ["direct_measurement", "scan", "trim"], "outputs": ["method/*-test-method-contract.json", "method/deliverable-ready.json"]},
    "RULE_REVIEW_METHOD": {"owner": "rule-reviewer", "gate": "scripts/review_method_batch.py", "families": ["direct_measurement", "scan", "trim"], "outputs": ["review/method-contract-review.json", "review/method-contract-review-deliverable-ready.json"]},
    "IMPLEMENTATION": {"owner": "ate-implementer", "gate": "scripts/verify_implementation_batch.py", "families": ["direct_measurement", "scan", "trim"], "outputs": ["implementation/implementation-manifest.json", "implementation/deliverable-ready.json"]},
    "RULE_REVIEW_IMPLEMENTATION": {"owner": "rule-reviewer", "gate": "scripts/verify_implementation_batch.py", "families": ["direct_measurement", "scan", "trim"], "outputs": ["review/implementation-review.json", "review/implementation-review-deliverable-ready.json"]},
    "COMPILE": {"owner": "compile-diagnostician", "gate": "scripts/run_ptc_incremental_compile.py", "families": ["all"], "outputs": ["compile/build-report.json", "compile/deliverable-ready.json"]}
  },
  "legacyPolicy": "Legacy Skills, state machines and specialized scripts are knowledge-only unless listed in legacy_migration_ledger.json. Captain may dispatch only this registry's stage owners and gates."
}
