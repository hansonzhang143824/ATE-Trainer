{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Review Evidence",
  "type": "object",
  "required": ["schemaVersion", "snapshotPath", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "snapshotPath": {"type": "string"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "assertionKind", "status", "scope", "candidateCount", "evidence"]}}
  }
}
