{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-report.schema.json",
  "title": "Independent verification report (TM600/TM601 real-new-capability + review disciplines)",
  "type": "object",
  "required": [
    "runId",
    "task",
    "producedBy",
    "subject",
    "verdict",
    "newCapabilityProof",
    "independentRecomputation",
    "develZeroWrite",
    "eightDisciplineAudit",
    "findings",
    "acceptanceResults",
    "commandsRun",
    "limitations"
  ],
  "properties": {
    "schema": {"type": "string"},
    "runId": {"type": "string"},
    "task": {"type": "string"},
    "producedBy": {"type": "string"},
    "generatedAt": {"type": "string"},
    "subject": {
      "type": "object",
      "required": ["claim"],
      "properties": {
        "claim": {"type": "string"},
        "deployedArtifact": {"$ref": "#/$defs/artifact"},
        "payloadArtifact": {"type": "object"}
      },
      "additionalProperties": true
    },
    "verdict": {"enum": ["pass", "fail", "blocked"]},
    "verdictReason": {"type": "string"},
    "newCapabilityProof": {
      "type": "object",
      "required": ["baseline", "goldenNotCopied", "deployedFunctions"],
      "properties": {
        "baseline": {"type": "object", "required": ["path", "sha256", "hits"], "additionalProperties": true},
        "goldenNotCopied": {"type": "object", "required": ["path", "sha256"], "additionalProperties": true},
        "deployedFunctions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "independentRecomputation": {
      "type": "object",
      "required": ["deployed"],
      "additionalProperties": true
    },
    "develZeroWrite": {"type": "object", "additionalProperties": true},
    "eightDisciplineAudit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "name", "status"],
        "properties": {
          "n": {"type": "integer"},
          "name": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not_applicable"]},
          "command": {"type": "string"},
          "exitCode": {"type": "integer"},
          "evidence": {"type": "array"}
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "problem", "requiredFix"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "blocker"]},
          "category": {"type": "string"},
          "problem": {"type": "string"},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "requiredFix": {"type": "string"},
          "evidence": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "acceptanceResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "properties": {
          "criterion": {"type": "string"},
          "status": {"enum": ["passed", "failed"]},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "commandsRun": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "status", "exitCode"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed"]},
          "exitCode": {"type": "integer"},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sizeBytes": {"type": "integer"},
        "sha256": {"type": "string"},
        "lines": {"type": "integer"},
        "bom": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
