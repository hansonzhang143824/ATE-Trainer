    CParam *MNT_V1P2_BUF_target = StsGetParam(funcindex, "MNT_V1P2_BUF_target");
    CParam *MNT_V1P2_BUF_post_value = StsGetParam(funcindex, "MNT_V1P2_BUF_post_value");
    CParam *MNT_V1P2_BUF_post_rt = StsGetParam(funcindex, "MNT_V1P2_BUF_post_rt");
    //}}AFX_STS_PARAM_PROTOTYPES

    TRIM_NODE &MNT_V1P2_BUF = trim_reg.trim("mnt_v1p2_buf");

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT -> VBAT_PD3_FXVI: K8 default NC
    // VDM  -> VDM_SDA_ACM: K59 default NC=VDM
    // K13_VBAT_Cap: VBAT 静态供电稳定 (FR-001: 供电→闭)
    cbite.SetOn(K13_VBAT_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    // vset[vbat,4.4,100e-6,0] -> VBAT=4.4V FV
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // 0x10=0x43(WAKE_UP); 0x57=0x04(EN_ATEST1); 0x58=0x02(ATEST1_MUX=2=VREF_1P2V_BUF)
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x04);
    I2CWriteSameData(DEV_ADDR, 0x58, 0x02);
    delay_ms(2);

    // ====== Step 4: Trim execute (measure 写 EFUSE + VDM MV) ======

    // VDM_SDA_ACM.Set(FI, 0, 10V, 10UA) 高阻: DUT ATEST 输出驱动 VDM pad
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    MNT_V1P2_BUF.execute(measure_mnt_v1p2_buf, spec, funcindex, funclabel, 1, 0, 0, 0);

    // ====== Step 5: Power Off (三步下电) ======
        VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
        VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    return 0;
}

// =====================================================================
// TM607/608/609 — BUBO ZCD / HS_NEG 电流阈值测试 (rampi_capv)
// 生成依据:
//   寄存器: reg_config/tm607.sv / tm608.sv / tm609.sv (field[] -> I2C 权威)
//   源表:   Pin_Channel_define.h
//   通路:   StdAfx.h PATH_RELAY 宏 (K_FPVIH_TO_* / K_FPVIL_TO_*, gen_path_defines.py 权威)
//   方法:   references/method/Current-Threshold.md (rampi_capv, 无迟滞单阈值)
//   风格:   test.cpp TM406_VBAT_LOW_VTH (六步法 + ramp*_capv + 三步下电)
//
// 用户修正 (2026-08-19):
//   TM607 LS_ZCD 下管:  电流 ramp 在 SW↔PGND  之间 (原 DFT iset[pmid_sw] 错)
//   TM608 HS_ZCD 上管:  电流 ramp 在 PMID↔SW  之间 (原 DFT iset[sw]     错)
//   TM609 HS_NEG 上管:  电流 ramp 在 PMID↔SW  之间 (原 DFT iset[sw]     错)
//   DTEST0 = nQON PIN (NQON_HG1_ACM 高阻读, K65_nQON_PU 上拉)
//
// 用户确认 (2026-08-19):
//   [A] VDRV = V1P5 短接 → 源表 V1P5_U34PS_FXVI (DALI_Net.NET V1P5_F/S net 含 TP_VDRV_F/S)
//   [B] trig 方向 = TRIG_RISING
//   [C] TM609 ramp = 0 → -3A (FPVIe_10A, 负向限流)
//   [D] 参数名 LS_ZCD / HS_ZCD / HS_NEG (DFT OVERVIEW isCodeGen=Y, meta 已补录)
// =====================================================================

// ---------------------------------------------------------------------
// TM607 BUCK_LS_ZCD — 下管 Low-Side FET 过零电流 (SW↔PGND ramp)
// 期望: 0.1A (ZCD 单阈值, 无迟滞)
// 新版硬件极性: FPVI0 High→PGND → DUT(LSFET) → SW1 → FPVI0 Low
// 芯片定义电流 SW→PGND = -FPVI0 电流，因此源表反向 ramp，结果再取负
// 电压:   VBAT=3.5V, PMID=5V, VDRV=5V
// 寄存器: BUBO force LS on (TM_LSON), DTEST0 mux=6
// ---------------------------------------------------------------------
DUT_API int TM607_BUCK_LS_ZCD(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *LS_ZCD = StsGetParam(funcindex, "LS_ZCD");
    //}}AFX_STS_PARAM_PROTOTYPES

    double ls_zcd[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流通路 (StdAfx.h PATH_RELAY 宏):
    //   PGND → FPVI0 High: K_FPVIH_TO_PGND_A = K136,K137,K143,K144,K154,K155
    //   SW   → FPVI0 Low : K60_BUSL0_VCP + K61_ACM8_SW
    //   BST  ← SW12_U1REF_BST_ACM: K48_ACM5_AMP_REF + K76_ACM_BST (FH5→BST)
    // 电压源默认 NC 直连 (VBAT K8 / PMID K83 / VDRV), 无需 SetOn
    // K13_VBAT_Cap: VBAT 静态供电稳定; K65_nQON_PU: nQON 上拉读 DTEST0
    cbite.SetOn(K_FPVIH_TO_PGND_A, K60_BUSL0_VCP, K61_ACM8_SW, K13_VBAT_Cap, K57_CAP_BST_SW, K48_ACM5_AMP_REF, K76_ACM_BST, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);
    // ====== Step 2: Power On (上电) ======
    // Golden LSZCD: 先用 FPVI0 FV=0 固定 SW=PGND=0，再建立 BST-SW=5V
    // 全程保证 BST>=SW 且 BST-SW<=5V
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // SW=0V, BST-SW=5V
    V1P5_U34PS_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VDRV=V1P5 短接
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // field[(WAKE_UP,1)] -> field[(D2A_BUBO_EN_FORCE_ON,1),(D2A_BUBO_TM_LSON,1),(BUBO_MODE,0)]
    //   -> field[(D2A_BUBO_TM_DIS_CLK,1)] -> field[(DMUX_EN,1),(DMUX_SEL,37),(D2A_BUBO_DTEST0,6)]
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x01);  // D2A_BUBO_TM_LSON=1 (下管 LS FET 导通)
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);  // D2A_BUBO_EN_FORCE_ON=1, BUBO_MODE=0
    delay_us(10);                             // 1e-5s
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    delay_ms(3);                              // 3e-3s
    I2CWriteSameData(DEV_ADDR, 0x56, 0x25);  // DMUX_SEL=37
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    I2CWriteSameData(DEV_ADDR, 0x5F, 0x06);  // D2A_BUBO_DTEST0=6 (LS ZCD)
    delay_ms(5);                              // 5e-3s

    // ====== Step 4: Measure (rampi_capv 电流 ramp, 捕 DTEST0 翻转) ======
    // FPVI0 源表电流 +0.2A -> -0.2A，对应芯片 SW->PGND 电流 -0.2A -> +0.2A
    // 翻转点源表电流取负后为 ZCD 阈值 (期望 +0.1A); trig 保持已确认的 RISING
    // LS FET 已导通后才从 FV 切 FI，避免切换期间 SW 浮动
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    delay_us(200);
    test_method.rampi_capv(FPVI0, FPVIe_1V, FPVIe_2A,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0.2, -0.2, 200, 20, 1.65, TRIG_RISING, ls_zcd);

    // ====== Step 5: Power Off (三步下电) ======
    // 先关电流, 再关电压 (FPVI 先 FI=0 再 FV=0)
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);  // 保持 SW=PGND=0
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);  // nQON cap 源下电
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        // 恢复为 DFT 定义的 SW->PGND 正方向；错误哨兵值保持不变
        if (ls_zcd[site] != ERROR_RES)
            ls_zcd[site] = -ls_zcd[site];
        LS_ZCD->SetTestResult(site, 0, ls_zcd[site]);
    }
    return 0;
}

// ---------------------------------------------------------------------
// TM608 BOOST_HS_ZCD — 上管 High-Side FET 过零电流 (PMID↔SW ramp)
// 期望: 0.1A (ZCD 单阈值, 无迟滞)
// 电流环: FPVI0 High→PMID → DUT(HSFET) → SW1 → FPVI0 Low
// 电压:   VBAT=3.5V, PMID=5V, BST_SW=5V
// 寄存器: BUBO force HS on (TM_HSON), DTEST0 mux=5
// ---------------------------------------------------------------------
DUT_API int TM608_BOOST_HS_ZCD(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *HS_ZCD = StsGetParam(funcindex, "HS_ZCD");
    //}}AFX_STS_PARAM_PROTOTYPES

    double hs_zcd[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流通路 (StdAfx.h PATH_RELAY 宏):
    //   PMID → FPVI0 High: K_FPVIH_TO_PMID_A = K83
    //   SW   → FPVI0 Low : K60_BUSL0_VCP + K61_ACM8_SW
    //   BST  ← SW12_U1REF_BST_ACM: K48_ACM5_AMP_REF + K76_ACM_BST (FH5→BST)
    // K13_VBAT_Cap: VBAT 供电稳定; K65_nQON_PU: nQON 上拉读 DTEST0
    cbite.SetOn(K_FPVIH_TO_PMID_A, K60_BUSL0_VCP, K61_ACM8_SW, K13_VBAT_Cap, K57_CAP_BST_SW, K48_ACM5_AMP_REF, K76_ACM_BST, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (BST-SW 台阶上电) ======
    // Golden HS_ZCD: FPVI0 FV=0 先固定 PMID=SW，再用独立源建立 BST-SW=5V
    // 全程保证 BST>=SW 且 BST-SW<=5V
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // PMID=SW=0V, BST-SW=5V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // FPVI FV=0 使 SW 跟随到 5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 10, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON); // SW=5V, BST-SW=5V
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // field[(WAKE_UP,1)] -> field[(D2A_BUBO_EN_FORCE_ON,1),(D2A_BUBO_TM_HSON,1),(BUBO_MODE,1)]
    //   -> field[(D2A_BUBO_TM_DIS_CLK,1)] -> field[(DMUX_EN,1),(DMUX_SEL,37),(D2A_BUBO_DTEST0,5)]
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x09, 0x0A);  // BUBO_MODE=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x02);  // D2A_BUBO_TM_HSON=1 (上管 HS FET 导通)
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);  // D2A_BUBO_EN_FORCE_ON=1
    delay_us(10);                             // 1e-5s
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    delay_ms(3);                              // 3e-3s
    I2CWriteSameData(DEV_ADDR, 0x56, 0x25);  // DMUX_SEL=37
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    I2CWriteSameData(DEV_ADDR, 0x5F, 0x05);  // D2A_BUBO_DTEST0=5 (HS ZCD)
    delay_ms(5);                              // 5e-3s

    // ====== Step 4: Measure (rampi_capv 电流 ramp, 捕 DTEST0 翻转) ======
    // FPVI0 ramp 电流 -0.2A -> +0.2A; nQON 捕 DTEST0 翻转点 = ZCD 阈值 (期望 0.1A)
    // HS FET 已导通后才从 FV 切 FI，保证切换前 PMID=SW
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    delay_us(200);
    test_method.rampi_capv(FPVI0, FPVIe_1V, FPVIe_2A,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           -0.2, 0.2, 200, 20, 1.65, TRIG_RISING, hs_zcd);

    // ====== Step 5: Power Off (BST-SW 反向台阶下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);  // PMID=SW=5V
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // BST-SW: 5V->0V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // SW 跟随到 0V, BST-SW=5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        HS_ZCD->SetTestResult(site, 0, hs_zcd[site]);
    }
    return 0;
}

// ---------------------------------------------------------------------
// TM609 BOOST_HS_NEG — 上管 High-Side 负向电流限 (PMID↔SW ramp)
// 期望: -3A (负向限流, 0→-3A ramp)
// 电流环: FPVI0 High→PMID → DUT(HSFET) → SW1 → FPVI0 Low
// 电压:   VBAT=3.5V, PMID=5V, BST_SW=5V, VDRV=5V
// 寄存器: BUBO force HS on + FPWM + ATEST0 mux=6, DTEST0 mux=5
// ---------------------------------------------------------------------
DUT_API int TM609_BOOST_HS_NEG(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *HS_NEG = StsGetParam(funcindex, "HS_NEG");
    //}}AFX_STS_PARAM_PROTOTYPES

    double hs_neg[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流通路: PMID→FPVI0 High (K_FPVIH_TO_PMID_A=K83); SW→FPVI0 Low (K60_BUSL0_VCP+K61_ACM8_SW); BST 供电 SW12_U1REF_BST_ACM (K48+K76)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K60_BUSL0_VCP, K61_ACM8_SW, K13_VBAT_Cap, K57_CAP_BST_SW, K48_ACM5_AMP_REF, K76_ACM_BST, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (BST-SW 台阶上电) ======
    // Golden HS_ZCD: FPVI0 FV=0 先固定 PMID=SW，再用独立源建立 BST-SW=5V
    // 全程保证 BST>=SW 且 BST-SW<=5V
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // PMID=SW=0V, BST-SW=5V
    V1P5_U34PS_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VDRV=V1P5 短接
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // FPVI FV=0 使 SW 跟随到 5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 10, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON); // SW=5V, BST-SW=5V
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // field[(WAKE_UP,1)] -> field[(D2A_BUBO_EN_FORCE_ON,1),(BUBO_MODE,1),(FPWM_EN,1)]
    //   -> field[(DMUX_EN,1),(DMUX_SEL,37),(D2A_BUBO_DTEST0,5),(EN_ATEST0,1),(D2A_BUBO_ATEST0_MUX,6)]
    //   -> field[(D2A_BUBO_TM_DIS_CLK,1)] -> field[(D2A_BUBO_TM_HSON,1)]
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x09, 0x1A);  // D2A_BUBO_EN_FORCE_ON=1, BUBO_MODE=1, FPWM_EN=1
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);  // D2A_BUBO_EN_FORCE_ON=1
    I2CWriteSameData(DEV_ADDR, 0x56, 0x25);  // DMUX_SEL=37
    I2CWriteSameData(DEV_ADDR, 0x57, 0x0A);  // DMUX_EN=1, EN_ATEST0=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x06);  // D2A_BUBO_ATEST0_MUX=6
    I2CWriteSameData(DEV_ADDR, 0x5F, 0x05);  // D2A_BUBO_DTEST0=5 (HS)
    delay_us(10);                             // 1e-5s
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    delay_ms(3);                              // 3e-3s
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x02);  // D2A_BUBO_TM_HSON=1 (上管 HS FET 导通)
    delay_ms(5);                              // 5e-3s

    // ====== Step 4: Measure (rampi_capv 电流 ramp, 捕 DTEST0 翻转) ======
    // FPVI0 ramp 电流 0 -> -3A (FPVIe_10A); nQON 捕 DTEST0 翻转点 = 负向限流阈值
    // HS FET 已导通后才从 FV 切 FI，保证切换前 PMID=SW
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    test_method.rampi_capv(FPVI0, FPVIe_1V, FPVIe_10A,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0.0, -3.0, 200, 20, 1.65, TRIG_RISING, hs_neg);  // [B] rising / [C] 0->-3A

    // ====== Step 5: Power Off (BST-SW 反向台阶下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // PMID=SW=5V
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // BST-SW: 5V->0V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // SW 跟随到 0V, BST-SW=5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        HS_NEG->SetTestResult(site, 0, hs_neg[site]);
    }
    return 0;
}

// =====================================================================
// TM614: BUBO VC_CLAMP_LOW — VC clamp low voltage (MV, V(COMP) on COMP pad)
// DFT: vset[vbat,5,100e-6,0] vset[pmid,5,100e-6,0] → en_tm[] →
//   0x10=0x43(WAKE_UP) 0x0E=0x7F(IBUS_SET=127) 0x59=0x20(D2A_BUBO_TM_DIS_CLK)
//   0x61=0x5B(EN_FORCE_ON,BUBO_MODE) 0x70=0x02(DIS_NTC_DETECTION_ANALOG,BUBO_SHORT_RCOMP)
//   → delay 10ms → finish V(COMP), expect 1.3V, measured 1.044
// 闭环: VBAT_PD3_FXVI(K8) + PMID_HG2_FXVI(K84) + COMP_VCN_ACM(K157, COMP pad)
// 无 ATEST mux 配置 → V(COMP) 直接在 COMP pad 高阻读, 非 AMUX 通路
// =====================================================================
DUT_API int TM614_VC_CLAMP_LOW(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VC_CLAMP_LOW = StsGetParam(funcindex, "VC_CLAMP_LOW");
    //}}AFX_STS_PARAM_PROTOTYPES

    double v_clamp_low[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT → VBAT_PD3_FXVI: K8 default NC (无 SetOn)
    // PMID → PMID_HG2_FXVI: K84 default NC (无 SetOn)
    // COMP → COMP_VCN_ACM:  K157_ACM11_COMP (Relay-ON, 需 SetOn)
    // K13_VBAT_Cap: VBAT 静态供电稳定; K85_CAP_PMID: PMID 供电稳定 (FR-001: 供电→闭Cap)
    cbite.SetOn(K13_VBAT_Cap, K85_CAP_PMID, K157_ACM11_COMP, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    // vset[vbat,5,100e-6,0] → VBAT=5V FV; 10V量程(≥2×5V), 100MA电流档
    VBAT_PD3_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    // vset[pmid,5,100e-6,0] → PMID=5V FV
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // en_tm[] → 进入测试模式 (寄存器铁律: 重上电后配置寄存器前必 entertestmode())
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x0E, 0x7F);  // IBUS_SET=127
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    I2CWriteSameData(DEV_ADDR, 0x61, 0x5B);  // D2A_BUBO_EN_FORCE_ON=1, BUBO_MODE=0
    I2CWriteSameData(DEV_ADDR, 0x70, 0x02);  // DIS_NTC_DETECTION_ANALOG=1, BUBO_SHORT_RCOMP=1
    delay_ms(10);                            // 10e-3s (DFT delay)

    // ====== Step 4: Measure (COMP pad 高阻 V(COMP)) ======
    // 无 ATEST mux → 直接在 COMP pad (K157) 高阻 V(COMP), 10V量程 10UA最小电流档
    COMP_VCN_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    COMP_VCN_ACM.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        v_clamp_low[site] = COMP_VCN_ACM.GetMeasResult(site, MVRET);
    }

    // ====== Step 5: Power Off (三步下电) ======
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    COMP_VCN_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    COMP_VCN_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VC_CLAMP_LOW->SetTestResult(site, 0, v_clamp_low[site]);
    }
    return 0;
}

// =====================================================================
// TM615: BUBO PSM_THREHOLD — VC threhold enter/exit PSM (Toggle, ramp AMUX→nQON)
// DFT: vset[vbat,3.5] vset[pmid,5] → en_tm[] → 0x10=0x43 0x59=0x20 0x61=0x4B
//   0x57=0x04(EN_ATEST1) 0x5B=0x50(ATEST1_MUX=5=EA_VC) 0x70=0x02
//   0x56=0x25(DMUX_SEL=37) 0x57=0x0C 0x5F=0x03(DTEST0=3) → vset[amux,1.3→1.5→1.3]
//   finish ATEST1(AMUX) V(DTEST0), measured r1.341/f1.392 (2段→3参数)
// 闭环: VBAT + PMID + AMUX_PGND_FXVI(K155 ramp) + NQON_HG1_ACM(K64+K65, DTEST0)
// =====================================================================
DUT_API int TM615_PSM_THREHOLD(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *PSM_THREHOLD_Rise = StsGetParam(funcindex, "PSM_THREHOLD_Rise");
    CParam *PSM_THREHOLD_Fall = StsGetParam(funcindex, "PSM_THREHOLD_Fall");
    CParam *PSM_THREHOLD_Hys = StsGetParam(funcindex, "PSM_THREHOLD_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect ======
    // VBAT → VBAT_PD3_FXVI: K8 default NC
    // PMID → PMID_HG2_FXVI: K84 default NC
    // AMUX → AMUX_PGND_FXVI: K155 default NC (ramp 源, 不闭 Cap)
    // nQON → NQON_HG1_ACM: K64 direct(default NC) + K65_nQON_PU pull-up
    // K13_VBAT_Cap: VBAT 供电稳定; K85_CAP_PMID: PMID 供电稳定 (FR-001: 供电→闭Cap)
    cbite.SetOn(K13_VBAT_Cap, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On ======
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x04);
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x50);
    I2CWriteSameData(DEV_ADDR, 0x70, 0x02);
    I2CWriteSameData(DEV_ADDR, 0x56, 0x25);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x0C);
    I2CWriteSameData(DEV_ADDR, 0x5F, 0x03);
    delay_ms(1);

    // ====== Step 4: Measure (rampv_capv: ramp AMUX V, 捕 nQON/DTEST0 翻转) ======
    // nQON high-Z reads DTEST0 logic level (inverted); AMUX 1.3→1.5→1.3 ramp
    // 上行 ramp: nQON 下降沿穿过 1.65V (inverted) → 捕获 rise 阈值
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };
    test_method.rampv_capv(AMUX_PGND_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_10MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           1.3, 1.5, 200, 20, 1.65, TRIG_FALLING, vth_r);
    // 下行 ramp: nQON 上升沿穿过 1.65V (inverted) → 捕获 fall 阈值
    test_method.rampv_capv(AMUX_PGND_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_10MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           1.5, 1.3, 200, 20, 1.65, TRIG_RISING, vth_f);
    FOR_EACH_VALID_SITE(site)
    {
        rise_result[site] = vth_r[site];
        fall_result[site] = vth_f[site];
    }
    // Hys = Rise - Fall (Toggle 两段式, 3参数; R-HYS: Hys 电压→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (rise_result[site] - fall_result[site]) * 1e3;  // V → mV
    }

    // ====== Step 5: Power Off (三步下电) ======
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        PSM_THREHOLD_Rise->SetTestResult(site, 0, rise_result[site]);
        PSM_THREHOLD_Fall->SetTestResult(site, 0, fall_result[site]);
        PSM_THREHOLD_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}

// =====================================================================
// TM616: BUBO VC_OFFSET — VC offset voltage (Toggle, ramp AMUX→捕 I(ATEST0) 电流)
// NTC等效VDM: DUT ATEST0 电流经 VDM pad (VDM_SDA_ACM, K59 NC=VDM) 测 I(ATEST0)
// DFT: vset[vbat,3.5] vset[pmid,5] → en_tm[] → 0x10=0x43 0x59=0x20 0x61=0x4B
//   0x70=0x02 0x57=0x06(EN_ATEST1+EN_ATEST0) 0x5B=0x52(ATEST1_MUX=5,ATEST0_MUX=2=PWM_V2I)
//   → vset[vdm,2,1e-3,0] delay 1ms → vset[amux,1.3→1.5→1.3] delay 1ms
//   finish ATEST1(AMUX) I(ATEST0), expect 1.4V, measured 1.41 (2段→3参数)
// 闭环: VBAT + PMID + AMUX_PGND_FXVI(K155 ramp) + VDM_SDA_ACM(K59 NC=VDM, FV=2V)
// 上行 ramp: I(ATEST0) 上升沿穿过 1µA (>0) → rise; 下行: 下降沿 → fall
// =====================================================================
DUT_API int TM616_VC_OFFSET(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VC_OFFSET_Rise = StsGetParam(funcindex, "VC_OFFSET_Rise");
    CParam *VC_OFFSET_Fall = StsGetParam(funcindex, "VC_OFFSET_Fall");
    CParam *VC_OFFSET_Hys = StsGetParam(funcindex, "VC_OFFSET_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect ======
    // VBAT → VBAT_PD3_FXVI: K8 default NC
    // PMID → PMID_HG2_FXVI: K84 default NC
    // AMUX → AMUX_PGND_FXVI: K155 default NC (ramp 源, 不闭 Cap)
    // VDM  → VDM_SDA_ACM:   K59 default NC=VDM (SetOn 才切 SDA); NTC 电流读数 pad
    // K13_VBAT_Cap: VBAT 供电稳定; K85_CAP_PMID: PMID 供电稳定 (FR-001: 供电→闭Cap)
    cbite.SetOn(K13_VBAT_Cap, K85_CAP_PMID, -1);
    delay_ms(3);

    // ====== Step 2: Power On ======
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);
    I2CWriteSameData(DEV_ADDR, 0x70, 0x02);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x52);
    delay_ms(1);

    // ====== Step 4: Measure (rampv_capi: ramp AMUX V, 捕 I(ATEST0) 电流穿越) ======
    // VDM 固定 FV=2V (cap_fv_value=2.0), I(ATEST0) 在 VDM pad 测, 触发点=电流穿阈值→返回 AMUX 电压
    // 上行 ramp: I(ATEST0) 上升沿穿过 1µA(>0) → rise; 下行: 下降沿 → fall
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };
    test_method.rampv_capi(AMUX_PGND_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_10MA,
                           VDM_SDA_ACM, ACM200_10V, ACM200_10UA,
                           2.0, 1.3, 1.5, 200, 20, 1e-6, TRIG_RISING, vth_r);
    test_method.rampv_capi(AMUX_PGND_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_10MA,
                           VDM_SDA_ACM, ACM200_10V, ACM200_10UA,
                           2.0, 1.5, 1.3, 200, 20, 1e-6, TRIG_FALLING, vth_f);
    FOR_EACH_VALID_SITE(site)
    {
        rise_result[site] = vth_r[site];
        fall_result[site] = vth_f[site];
    }
    // Hys = Rise - Fall (Toggle 两段式, 3参数; R-HYS: Hys 电压→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (rise_result[site] - fall_result[site]) * 1e3;  // V → mV
    }

    // ====== Step 5: Power Off (三步下电) ======
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VC_OFFSET_Rise->SetTestResult(site, 0, rise_result[site]);
        VC_OFFSET_Fall->SetTestResult(site, 0, fall_result[site]);
        VC_OFFSET_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}

// =====================================================================
// TM640: BUBO BOOST HS OCP — boost mode HS current limit (HS OCP 阈值)
// DFT: vset[vbat,3.5] vset[pmid,5] vset[bst_sw,5] vset[vdrv,5] vset[vdm,1] → en_tm[] →
//   field[(WAKE_UP,1)] field[(D2A_BUBO_TM_HSON,1),(BUBO_MODE,1),(D2A_BUBO_TM_LOW_ILIMT_OFF,1)]
//   field[(DIS_NTC_DETECTION_ANALOG,1),(D2A_OVRD_SEL,3)] delay[5e-5] field[(D2A_BUBO_EN_FORCE_ON,1)]
//   delay[1e-5] field[(D2A_BUBO_TM_DIS_CLK,1)] delay[1e-3] field[(D2A_BUBO_TM_BOOST_OCP_EN,1)]
//   field[(DMUX_EN,1),(DMUX_SEL,37),(D2A_BUBO_DTEST0,7)] → delay[1e-3] iset[sw,-2,1e-3,0](电流ramp) →
//   delay[1e-3] field[(EN_ATEST0,1),(D2A_BUBO_ATEST0_MUX,5)] delay[1e-3]
//   field[(BUBO_BOOST_OCP_OPT,1)] delay[1e-3] → finish, expect 1.5A (foldback 1/10 from 15A, 翻转2.05A)
// 测量: FPVI0 电流 ramp (PMID↔SW) 捕 DTEST0 翻转, 翻转点 ISW = HS OCP 阈值 (不读 ATEST0, 用户拍板)
// 闭环: FPVI0(K83 High→PMID / K60+K61 Low→SW) + SW12_U1REF_BST_ACM(BST, K48+K76) + V1P5_U34PS_FXVI(VDRV)
//   + VBAT_PD3_FXVI + PMID_HG2_FXVI + NQON_HG1_ACM(K65 nQON_PU, DTEST0) + VDM_SDA_ACM(K59 NC=VDM)
// =====================================================================
DUT_API int TM640_BOOST_HS_OCP(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *BOOST_HS_OCP = StsGetParam(funcindex, "BOOST_HS_OCP");
    //}}AFX_STS_PARAM_PROTOTYPES

    double boost_ocp[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流通路: PMID→FPVI0 High (K_FPVIH_TO_PMID_A=K83); SW→FPVI0 Low (K60_BUSL0_VCP+K61_ACM8_SW); BST 供电 SW12_U1REF_BST_ACM (K48+K76)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K60_BUSL0_VCP, K61_ACM8_SW, K13_VBAT_Cap, K57_CAP_BST_SW, K48_ACM5_AMP_REF, K76_ACM_BST, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (BST-SW 台阶上电 + VDM) ======
    // DFT: vbat=3.5V pmid=5V bst_sw=5V vdrv=5V vdm=1V; FPVI0 FV=0 先固定 PMID=SW，再建立 BST-SW=5V
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // PMID=SW=0V, BST-SW=5V
    V1P5_U34PS_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VDRV=V1P5 短接
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID=5V, SW 跟随到 5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 10, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON); // SW=5V, BST-SW=5V
    VDM_SDA_ACM.Set(FV, 1, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);      // VDM=1V (K59 NC=VDM 直连)
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, tm640.sv OCP 序列) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x09, 0x0A);  // BUBO_MODE=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x02);  // D2A_BUBO_TM_HSON=1, D2A_BUBO_TM_LOW_ILIMT_OFF=1
    I2CWriteSameData(DEV_ADDR, 0x67, 0x03);  // DIS_NTC_DETECTION_ANALOG=1, D2A_OVRD_SEL=3
    delay_us(50);                            // delay[5e-5]
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);  // D2A_BUBO_EN_FORCE_ON=1
    delay_us(10);                            // delay[1e-5]
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    delay_ms(1);                             // delay[1e-3]
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x06);  // D2A_BUBO_TM_HSON=1, D2A_BUBO_TM_BOOST_OCP_EN=1
    I2CWriteSameData(DEV_ADDR, 0x56, 0x25);  // DMUX_SEL=37
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    I2CWriteSameData(DEV_ADDR, 0x5F, 0x07);  // D2A_BUBO_DTEST0=7 (HS OCP)
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 4: Measure (rampi_capv 电流 ramp, 捕 DTEST0 翻转) ======
    // FPVI0 ramp 电流 0 → -3A (FPVIe_10A), nQON 捕 DTEST0 翻转点 = HS OCP 阈值
    // iset[sw,-2,1e-3,0] 由 rampi_capv 电流 ramp 实现; 翻转点 ISW 直接作结果 (不读 ATEST0)
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    test_method.rampi_capv(FPVI0, FPVIe_1V, FPVIe_10A,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0.0, -3.0, 200, 20, 1.65, TRIG_RISING, boost_ocp);
    // DFT 尾部寄存器 (忠实序列; ATEST0 部分仅配置, 不读取)
    delay_ms(1);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x0A);  // EN_ATEST0=1 (DMUX_EN 保持)
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x05);  // D2A_BUBO_ATEST0_MUX=5
    delay_ms(1);
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4F);  // BUBO_BOOST_OCP_OPT=1
    delay_ms(1);

    // ====== Step 5: Power Off (BST-SW 反向台阶下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // PMID=SW=5V
    SW12_U1REF_BST_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // BST-SW: 5V→0V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // SW 跟随到 0V, BST-SW=5V
    delay_us(200);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    SW12_U1REF_BST_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        BOOST_HS_OCP->SetTestResult(site, 0, boost_ocp[site]);
    }
    return 0;
}

// =====================================================================
// TM641: BUBO BST UV — BST-SW 差分 UV 阈值 (Toggle, FPVI0 差分 ramp 捕 DTEST0 翻转)
// FPVI0 浮动源直接跨 BST-SW 维持差分 (忠实 DFT vset[bst_sw] 差分语义):
//   ACM200_FH8(VCP_SW_ACM) 经 K61 把 SW 钉死 3V 绝对 → FPVI0 Low 跟随 SW, High=BST=SW+差分
//   DFT 期待 BST-SW 差分 2.5→4.0V (vset[bst_sw]); 触发点电压直接 = BST-SW 阈值, 无需减 SW 偏置
// 继电器: FPVI0 High→BST (K_FPVIH_TO_BST_A = K46+K48+K76), FPVI0 Low→SW (K60+K61), ACM200_FH8→SW (共用 K61)
//   ⚠ K48/K76 与 ACM200_FH5(SW12_U1REF_BST_ACM) 共用接入 BST → 该源全程 RELAY_OFF 不驱动
// DFT: vbat=3.5V pmid=5V bst_sw=5V vdrv=5V sw=3V → en_tm[] → 0x10=0x43 0x61=0x4B
//   0x56=0x0B(DMUX_SEL=11) 0x57=0x08(DMUX_EN) → delay 10us → 0x59=0x20(DIS_CLK) → delay 100us
//   → bst_sw 2.5→4.0 两段斜坡 (10e-3) delay 100us → delay 1ms finish, O=VBAT P=BST-SW
// 观测: DTEST0 (nQON High-Z 读逻辑电平, 反向): 升扫 TRIG_FALLING / 降扫 TRIG_RISING (TM615/640 同)
// 两段斜坡 → Toggle 3 参数 (R-HYS: Hys 电压→mV); BST-SW 台阶对: 每步 BST≥SW 且压差≤5V
// 回环: VBAT + PMID + VDRV + SW(ACM200_FH8=3V) + FPVI0(BST-SW 差分) + nQON 观测
// =====================================================================
DUT_API int TM641_BST_UV(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *BST_UV_Rise = StsGetParam(funcindex, "BST_UV_Rise");
    CParam *BST_UV_Fall = StsGetParam(funcindex, "BST_UV_Fall");
    CParam *BST_UV_Hys = StsGetParam(funcindex, "BST_UV_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // FPVI0 High→BST (K_FPVIH_TO_BST_A = K46_BUS0_FH_SW1 + K48_ACM5_AMP_REF + K76_ACM_BST)
    // FPVI0 Low→SW (K60_BUSL0_VCP + K61_ACM8_SW); ACM200_FH8(VCP_SW_ACM)→SW 共用 K61
    // ⚠ K48/K76 同时把 ACM200_FH5(SW12_U1REF_BST_ACM) 输出端接 BST → 该源全程 RELAY_OFF 不驱动
    // Cap2 (FR-001 按PIN): BST_SW 是差分 ramp 源 → 移除 K57_CAP_BST_SW (Cap 拖慢 ramp); PMID/VBAT 静态供电 → K85_CAP_PMID + K13_VBAT_Cap
    cbite.SetOn(K_FPVIH_TO_BST_A, K60_BUSL0_VCP, K61_ACM8_SW, K13_VBAT_Cap, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (SW 钉死 3V 绝对, FPVI0 建 BST-SW 差分台阶) ======
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 0: BST=SW
    delay_us(200);
    VCP_SW_ACM.Set(FV, 3, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // SW=3V 绝对 (ACM200 定死), FPVI0 Low 跟随
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 3.5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VBAT=3.5V
    V1P5_U34PS_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VDRV=V1P5 短接
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID=5V
    delay_us(200);
    FPVI0.Set(FV, 5, FPVIe_10V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 0→5V: BST=SW+5=8V (台阶对 BST≥SW, 压差 5V≤5V)
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, tm641.sv BST UV 序列) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x61, 0x4B);  // D2A_BUBO_EN_FORCE_ON=1
    I2CWriteSameData(DEV_ADDR, 0x56, 0x0B);  // DMUX_SEL=11
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    delay_us(10);                            // delay[10e-6]
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    delay_us(100);                           // delay[100e-6]

    // ====== Step 4: Measure (FPVI0 差分 ramp BST-SW, 捕 DTEST0 翻转) ======
    // DFT 尾部: vset[bst_sw,2.5,10e-3] → vset[bst_sw,4,10e-3] 两段斜坡 → Toggle 3 参数 (升+降)
    // FPVI0 浮动源直接 ramp BST-SW 差分 2.5→4.0V; 触发点 FPVI0 电压 = BST-SW 阈值 (无需减偏置)
    // nQON 读数与 ramp 反向 (TM615 同): 升扫 TRIG_FALLING 捕 rise / 降扫 TRIG_RISING 捕 fall
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           2.5, 4.0, 200, 20, 1.65, TRIG_FALLING, vth_r);   // 升扫: BST-SW 2.5→4.0V
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           4.0, 2.5, 200, 20, 1.65, TRIG_RISING, vth_f);   // 降扫: BST-SW 4.0→2.5V
    FOR_EACH_VALID_SITE(site)
    {
        rise_result[site] = vth_r[site];  // FPVI0 差分触发点 = BST-SW UV 阈值 (直接结果, 无需减偏置)
        fall_result[site] = vth_f[site];
    }
    // Hys = Rise - Fall (Toggle 两段式 3 参数; R-HYS: Hys 电压→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (rise_result[site] - fall_result[site]) * 1e3;  // V → mV
    }
    delay_ms(1);                             // delay[1e-3] finish[]

    // ====== Step 5: Power Off (BST-SW 反向台阶下电) ======
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 5→0V: BST=SW=3V
    delay_us(200);
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // SW 3→0V, BST 跟随 0V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        BST_UV_Rise->SetTestResult(site, 0, rise_result[site]);
        BST_UV_Fall->SetTestResult(site, 0, fall_result[site]);
        BST_UV_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}
// =====================================================================
// TM643: VBAT_LOOP_INDICTOR — VBAT 环路指示器比较器翻转阈值 (Toggle)
// DFT OVERVIEW: monitor vbat indictor comparator flip; expect Rise 3.506 / Fall 3.43 (VBAT 电压)
//   实测 bench: Rise 3.48 / Fall 3.45; VBAT REF=4.2V (VBAT_CV=1), 无需电流
// 回环: VBAT_PD3_FXVI(=5V, ramp 5→3→5) + PMID_HG2_FXVI(=5V) + FPVI0(BST-SW 差分浮动=5V)
//   + V1P5_U34PS_FXVI(VDRV=5V) + VDM_SDA_ACM(读 a2d_vbat_loop_on 逻辑)
// 观测: ATEST1→VDM pad (0x57=0x0C=DMUX_EN+EN_ATEST1, DMUX_SEL=7=a2d_vbat_loop_on, ATEST1_MUX=3)
//   VDM 高阻读逻辑电平; 升扫(VBAT 低→高) 指示器 HIGH→LOW=TRIG_FALLING 捕 rise;
//   降扫(VBAT 高→低) LOW→HIGH=TRIG_RISING 捕 fall (TM641 同向约定)
// 寄存器 (tm643.sv): 0x10=0x43(WAKE_UP) → 0x0A=0x41(BUBO_MODE=0,VBAT_CV=1) → 0x0E=0x39(IBUS_SET=57)
//   → 0x56=0x07(DMUX_SEL=7) 0x57=0x0C(DMUX_EN+EN_ATEST1) 0x58=0x03(ATEST1_MUX=3)
//   0x61=0x53(VBUS_LOOP_DISABLE=1,DIS_NTC) → delay 1e-5 → 0x59=0x20(DIS_CLK) → 0x61=0x5B(EN_FORCE_ON) → delay 1e-3
// 测量 (DFT): delay 2e-3 → vbat 5→3V (降扫捕 fall) → vbat 3→5V (升扫捕 rise) → delay 1e-3
// 继电器: FPVI0 High→BST(K_FPVIH_TO_BST_A=K46+K48+K76) + Low→SW(K60+K61); VBAT(K13_Cap) + PMID(K85_Cap)
//   ⚠ K48/K76 同时把 ACM200_FH5(SW12_U1REF_BST_ACM) 输出端接 BST → 该源全程不驱动
// 两段斜坡 → Toggle 3 参数 (R-HYS: Hys 电压→mV)
// =====================================================================
DUT_API int TM643_VBAT_LOOP_INDICTOR(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VBAT_LOOP_Rise = StsGetParam(funcindex, "VBAT_LOOP_Rise");
    CParam *VBAT_LOOP_Fall = StsGetParam(funcindex, "VBAT_LOOP_Fall");
    CParam *VBAT_LOOP_Hys = StsGetParam(funcindex, "VBAT_LOOP_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // FPVI0 High→BST (K_FPVIH_TO_BST_A = K46_BUS0_FH_SW1 + K48_ACM5_AMP_REF + K76_ACM_BST)
    // FPVI0 Low→SW (K60_BUSL0_VCP + K61_ACM8_SW); BST_SW 浮动差分源, SW 无锚定 (.sv 无 vset[sw])
    // nQON 观测: K65_nQON_PU 上拉 + NQON_HG1_ACM 高阻读 DTEST0 逻辑电平 (TM641 同)
    // Cap (E012/FR-001 按PIN): VBAT 是 ramp 源 → 不闭 K13_VBAT_Cap (Cap 拖慢 ramp, TM400-402 VBUS ramp 先例); PMID 静态 → K85_CAP_PMID
    cbite.SetOn(K_FPVIH_TO_BST_A, K60_BUSL0_VCP, K61_ACM8_SW, K85_CAP_PMID, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (BST-SW 差分浮动台阶 + VBAT) ======
    // DFT/.sv: vbat=5V pmid=5V bst_sw=5V(差分) vdrv=5V (floating source V(BST_SW), 无 vset[sw])
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 0: BST=SW
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VBAT=5V (ramp 起点)
    V1P5_U34PS_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VDRV=V1P5 短接
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID=5V
    delay_us(200);
    FPVI0.Set(FV, 5, FPVIe_10V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 0→5V (floating, SW 无锚定)
    delay_ms(1);

    // ====== Step 3: Register Config (tm643.sv VBAT_LOOP 序列, 观测改 DTEST0/nQON) ======
    // ⚠ DFT 错误修正: .sv 主字段 EN_ATEST1+ATEST1_MUX (0x57=0x0C / 0x58=0x03) 是 ATEST1→VDM 观测, 为错误设计
    //   OVERVIEW checked 备注 (实测权威): VBAT REF 4.2V, Ramp VBAT voltage and monitor INT toggle, 观测列 = DTEST0
    //   → 0x57=0x08 (仅 DMUX_EN), 删 0x58; DMUX_SEL=7 → a2d_vbat_loop_on 直出 DTEST0 (TM641 同模式, 无需 0x5F)
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x0A, 0x41);  // BUBO_MODE=0, VBAT_CV=1
    I2CWriteSameData(DEV_ADDR, 0x0E, 0x39);  // IBUS_SET=57
    I2CWriteSameData(DEV_ADDR, 0x56, 0x07);  // DMUX_SEL=7 → a2d_vbat_loop_on
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1 (去掉 EN_ATEST1: 观测走 DTEST0/nQON)
    I2CWriteSameData(DEV_ADDR, 0x61, 0x53);  // VBUS_LOOP_DISABLE=1, DIS_NTC_DETECTION_ANALOG=1
    delay_us(10);                            // delay[1e-5]
    I2CWriteSameData(DEV_ADDR, 0x59, 0x20);  // D2A_BUBO_TM_DIS_CLK=1
    I2CWriteSameData(DEV_ADDR, 0x61, 0x5B);  // D2A_BUBO_EN_FORCE_ON=1
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 4: Measure (VBAT 两段 ramp 捕 DTEST0/nQON 翻转) ======
    // DFT 尾部: delay 2e-3 → vbat 5→3V (降扫) → vbat 3→5V (升扫) → delay 1e-3 finish
    // 期望 (OVERVIEW checked): Rise 3.48 / Fall 3.45 / Hys≈0 (无迟滞)
    // nQON 读数与 ramp 反向 (TM641/615 同): 升扫 TRIG_FALLING 捕 rise / 降扫 TRIG_RISING 捕 fall
    double vth_f[SITE_NUM] = { 0 };
    double vth_r[SITE_NUM] = { 0 };
    delay_ms(2);
    test_method.rampv_capv(VBAT_PD3_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           5.0, 3.0, 200, 20, 1.65, TRIG_RISING, vth_f);   // 降扫 5→3V: fall 阈值
    test_method.rampv_capv(VBAT_PD3_FXVI, FXVIe_PLUS_10V, FXVIe_PLUS_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           3.0, 5.0, 200, 20, 1.65, TRIG_FALLING, vth_r);   // 升扫 3→5V: rise 阈值
    FOR_EACH_VALID_SITE(site)
    {
        fall_result[site] = vth_f[site];  // VBAT 降扫翻转点 (Fall 阈值)
        rise_result[site] = vth_r[site];  // VBAT 升扫翻转点 (Rise 阈值)
    }
    // Hys = Rise - Fall (Toggle 两段式 3 参数; R-HYS: Hys 电压→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (rise_result[site] - fall_result[site]) * 1e3;  // V → mV
    }
    delay_ms(1);                             // delay[1e-3] finish[]

    // ====== Step 5: Power Off (BST-SW 反向台阶下电) ======
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);  // BST-SW 差分 5→0V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    V1P5_U34PS_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VBAT_LOOP_Rise->SetTestResult(site, 0, rise_result[site]);
        VBAT_LOOP_Fall->SetTestResult(site, 0, fall_result[site]);
        VBAT_LOOP_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}

// =====================================================================
// TM700: IBUS_SNS_ACC_BU — IBUS 电流采样精度 Buck 模式 (1P0A/2P0A/0P5A)
// DFT: IBUS sense in buck mode; (ATEST0-ATEST1)/0.2 VS I_input; chop enable; expect ±3%
//   ATEST0_MUX=25(IBUS_SNS_FB)→VDM pad, ATEST1_MUX=7(IBUS_SNS_BASE)→AMUX pad (双 pad 同时读, 0x57=0x06 不切换)
//   ⚠ AMUX 上默认挂 FXVIe_PLUS FH3(AMUX_PGND_FXVI) → RELAY_OFF 防负载弱 ATEST 输出 (DFT: BENCH 需修复 amux 上挂电阻问题)
// 电流环 (Buck): FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); iset[pmid] → FPVI0.Set(FI, -I) 电流 VBUS→PMID
//   Imeas = VCS/0.2 (VCS = V(VDM)-V(AMUX)); Iforce = |FPVI0 MIRET| (measured-back, 用户要求)
//   acc% = (Imeas - Iforce)/Iforce×100
// 参数: IBUS_ACC_1P0A / IBUS_ACC_2P0A / IBUS_ACC_0P5A (%)
// =====================================================================
DUT_API int TM700_IBUS_SNS_ACC_BU(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBUS_ACC_1P0A = StsGetParam(funcindex, "IBUS_ACC_1P0A");
    CParam *IBUS_ACC_2P0A = StsGetParam(funcindex, "IBUS_ACC_2P0A");
    CParam *IBUS_ACC_0P5A = StsGetParam(funcindex, "IBUS_ACC_0P5A");
    //}}AFX_STS_PARAM_PROTOTYPES

    double acc_1p0a[SITE_NUM] = { 0 };
    double acc_2p0a[SITE_NUM] = { 0 };
    double acc_0p5a[SITE_NUM] = { 0 };
    double vcs[3][SITE_NUM] = {};
    double iforce[3][SITE_NUM] = {};

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流环: FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); ATEST1→AMUX(K20); ATEST0→VDM(K59 NC)
    // 供电 cap: VBAT(K13) + VBUS(K5)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K_FPVIL_TO_DRVH1_A, K20_ACM0_AMUX, K13_VBAT_Cap, K5_VBUS_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (Buck: VBAT=4.4V, VBUS=5V) ======
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // 先固定 PMID-VBUS 差分 0
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    VBUS_DRVH1_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // VBUS=5V, PMID 跟随 5V
    delay_us(200);
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);      // ATEST0→VDM 高阻读
    VAC123_AMUX_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);  // ATEST1→AMUX 高阻读
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);  // 断开 FXVIe 防挂载
    delay_ms(1);

    // ====== Step 3: Register Config (tm700.sv: 双 pad 同时使能, chop 保持默认开) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // EN_ATEST0 + EN_ATEST1
    I2CWriteSameData(DEV_ADDR, 0x58, 0x07);  // ATEST1_MUX=7 → IBUS_SNS_BASE
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x19);  // ATEST0_MUX=25 → IBUS_SNS_FB
    delay_ms(2);

    // ====== Step 4: Measure (1A/2A/0.5A 三点精度, Buck 负电流 VBUS→PMID) ======
    double cur_pts[3] = { 1.0, 2.0, 0.5 };
    for (int pt = 0; pt < 3; pt++)
    {
        FPVI0.Set(FI, -cur_pts[pt], FPVIe_1V, (cur_pts[pt] <= 1.0 ? FPVIe_2A : FPVIe_10A), FPVIe_RELAY_ON);
        delay_ms(2);
        VDM_SDA_ACM.MeasureVI(50, 5);
        VAC123_AMUX_ACM.MeasureVI(50, 5);
        FPVI0.MeasureVI(50, 5);
        FOR_EACH_VALID_SITE(site)
        {
            vcs[pt][site] = VDM_SDA_ACM.GetMeasResult(site, MVRET) - VAC123_AMUX_ACM.GetMeasResult(site, MVRET);  // VCS = V(VDM)-V(AMUX)
            iforce[pt][site] = -FPVI0.GetMeasResult(site, MIRET);  // Buck 负电流 → 取反为幅值
        }
    }
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_ms(1);
    FOR_EACH_VALID_SITE(site)
    {
        if (iforce[0][site] > 1e-6) acc_1p0a[site] = (vcs[0][site] / 0.2 - iforce[0][site]) / iforce[0][site] * 100;
        if (iforce[1][site] > 1e-6) acc_2p0a[site] = (vcs[1][site] / 0.2 - iforce[1][site]) / iforce[1][site] * 100;
        if (iforce[2][site] > 1e-6) acc_0p5a[site] = (vcs[2][site] / 0.2 - iforce[2][site]) / iforce[2][site] * 100;
    }

    // ====== Step 5: Power Off (三步下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // PMID=VBUS=5V
    delay_us(200);
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);  // VBUS→0, PMID 跟随
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        IBUS_ACC_1P0A->SetTestResult(site, 0, acc_1p0a[site]);
        IBUS_ACC_2P0A->SetTestResult(site, 0, acc_2p0a[site]);
        IBUS_ACC_0P5A->SetTestResult(site, 0, acc_0p5a[site]);
    }
    return 0;
}

// =====================================================================
// TM701: IBUS_SNS_ACC_BO — IBUS 电流采样精度 Boost 模式 (1P0A/2P0A/0P5A)
// DFT: IBUS sense in boost mode; (ATEST0-ATEST1)/0.2 VS I_input; chop enable; expect ±3%
//   ATEST0_MUX=25(IBUS_SNS_FB)→VDM, ATEST1_MUX=7(IBUS_SNS_BASE)→AMUX; BUBO_MODE=1
// 电流环 (Boost): FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); iset[vbus] → FPVI0.Set(FI, +I) 电流 PMID→VBUS
//   Imeas = VCS/0.2; Iforce = |FPVI0 MIRET|; acc% = (Imeas - Iforce)/Iforce×100
// 参数: IBUS_ACC_1P0A / IBUS_ACC_2P0A / IBUS_ACC_0P5A (%)
// =====================================================================
DUT_API int TM701_IBUS_SNS_ACC_BO(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBUS_ACC_1P0A = StsGetParam(funcindex, "IBUS_ACC_1P0A");
    CParam *IBUS_ACC_2P0A = StsGetParam(funcindex, "IBUS_ACC_2P0A");
    CParam *IBUS_ACC_0P5A = StsGetParam(funcindex, "IBUS_ACC_0P5A");
    //}}AFX_STS_PARAM_PROTOTYPES

    double acc_1p0a[SITE_NUM] = { 0 };
    double acc_2p0a[SITE_NUM] = { 0 };
    double acc_0p5a[SITE_NUM] = { 0 };
    double vcs[3][SITE_NUM] = {};
    double iforce[3][SITE_NUM] = {};

    // ====== Step 1: Connect (继电器闭合) ======
    // 电流环: FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); ATEST1→AMUX(K20); ATEST0→VDM(K59 NC)
    // 供电 cap: VBAT(K13) + PMID(K85)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K_FPVIL_TO_DRVH1_A, K20_ACM0_AMUX, K13_VBAT_Cap, K85_CAP_PMID, -1);
    delay_ms(3);

    // ====== Step 2: Power On (Boost: VBAT=4.4V, PMID=5V) ======
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // 先固定 PMID-VBUS 差分 0
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID=5V, VBUS 跟随 5V
    delay_us(200);
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);      // ATEST0→VDM 高阻读
    VAC123_AMUX_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);  // ATEST1→AMUX 高阻读
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);  // 断开 FXVIe 防挂载
    delay_ms(1);

    // ====== Step 3: Register Config (tm701.sv: 双 pad + BUBO_MODE=1, chop 保持默认开) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x09, 0x0A);  // BUBO_MODE=1 (Boost)
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // EN_ATEST0 + EN_ATEST1
    I2CWriteSameData(DEV_ADDR, 0x58, 0x07);  // ATEST1_MUX=7 → IBUS_SNS_BASE
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x19);  // ATEST0_MUX=25 → IBUS_SNS_FB
    delay_ms(2);

    // ====== Step 4: Measure (1A/2A/0.5A 三点精度, Boost 正电流 PMID→VBUS) ======
    double cur_pts[3] = { 1.0, 2.0, 0.5 };
    for (int pt = 0; pt < 3; pt++)
    {
        FPVI0.Set(FI, cur_pts[pt], FPVIe_1V, (cur_pts[pt] <= 1.0 ? FPVIe_2A : FPVIe_10A), FPVIe_RELAY_ON);
        delay_ms(2);
        VDM_SDA_ACM.MeasureVI(50, 5);
        VAC123_AMUX_ACM.MeasureVI(50, 5);
        FPVI0.MeasureVI(50, 5);
        FOR_EACH_VALID_SITE(site)
        {
            vcs[pt][site] = VDM_SDA_ACM.GetMeasResult(site, MVRET) - VAC123_AMUX_ACM.GetMeasResult(site, MVRET);  // VCS = V(VDM)-V(AMUX)
            iforce[pt][site] = FPVI0.GetMeasResult(site, MIRET);  // Boost 正电流 → 直接为幅值
        }
    }
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_ms(1);
    FOR_EACH_VALID_SITE(site)
    {
        if (iforce[0][site] > 1e-6) acc_1p0a[site] = (vcs[0][site] / 0.2 - iforce[0][site]) / iforce[0][site] * 100;
        if (iforce[1][site] > 1e-6) acc_2p0a[site] = (vcs[1][site] / 0.2 - iforce[1][site]) / iforce[1][site] * 100;
        if (iforce[2][site] > 1e-6) acc_0p5a[site] = (vcs[2][site] / 0.2 - iforce[2][site]) / iforce[2][site] * 100;
    }

    // ====== Step 5: Power Off (三步下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // VBUS=PMID=5V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID→0, VBUS 跟随
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        IBUS_ACC_1P0A->SetTestResult(site, 0, acc_1p0a[site]);
        IBUS_ACC_2P0A->SetTestResult(site, 0, acc_2p0a[site]);
        IBUS_ACC_0P5A->SetTestResult(site, 0, acc_0p5a[site]);
    }
    return 0;
}

// =====================================================================
// TM702_1: IBUS_SNS_GAIN_test_BUCK — IBUS sense Gain 测试 Buck 模式 (两点做差)
// DFT: BUCK mode, force VBUS2PMID 1A/3A, measure ATEST0; gain=(deltaV@3A-deltaV@1A)/2
//   (ATEST1-ATEST0)/ibus 为 sense ratio, 理论 0.2 V/A=200mohm; 报告 Gain 本身 (mohm)
// 电流环 (Buck): FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); iset[pmid,1/3] → FPVI0.Set(FI, -1/-3)
// VCS = V(VDM)-V(AMUX) (ATEST0→VDM, ATEST1→AMUX, 双 pad); Iforce = |FPVI0 MIRET|
//   Gain = (VCS3-VCS1)/(I3-I1)×1e3 (mohm), 对比理论 0.2Ω
// 寄存器: 同 TM700 (WAKE_UP + 双 pad ATEST mux, BUBO_MODE=0 无 0x09)
// 参数: IBUS_SNS_GAIN (mohm)
// =====================================================================
DUT_API int TM702_1_IBUS_SNS_GAIN_TEST_BUCK(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBUS_SNS_GAIN = StsGetParam(funcindex, "IBUS_SNS_GAIN");
    //}}AFX_STS_PARAM_PROTOTYPES

    double gain[SITE_NUM] = { 0 };
    double vcs1[SITE_NUM] = { 0 };
    double vcs3[SITE_NUM] = { 0 };
    double im1[SITE_NUM] = { 0 };
    double im3[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合, 同 TM700 Buck) ======
    // 电流环: FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); ATEST1→AMUX(K20); ATEST0→VDM(K59 NC)
    // 供电 cap: VBAT(K13) + VBUS(K5)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K_FPVIL_TO_DRVH1_A, K20_ACM0_AMUX, K13_VBAT_Cap, K5_VBUS_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (Buck: VBAT=4.4V, VBUS=5V) ======
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    VBUS_DRVH1_ACM.Set(FV, 5, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    delay_us(200);
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    delay_ms(1);

    // ====== Step 3: Register Config (tm702_1.sv: 同 TM700, BUBO_MODE=0 无 0x09) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // EN_ATEST0 + EN_ATEST1
    I2CWriteSameData(DEV_ADDR, 0x58, 0x07);  // ATEST1_MUX=7 → IBUS_SNS_BASE
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x19);  // ATEST0_MUX=25 → IBUS_SNS_FB
    delay_ms(2);

    // ====== Step 4: Measure (1A/3A 两点, Buck 负电流 VBUS→PMID) ======
    FPVI0.Set(FI, -1.0, FPVIe_1V, FPVIe_2A, FPVIe_RELAY_ON);  // 1A 点
    delay_ms(2);
    VDM_SDA_ACM.MeasureVI(50, 5);
    VAC123_AMUX_ACM.MeasureVI(50, 5);
    FPVI0.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vcs1[site] = VDM_SDA_ACM.GetMeasResult(site, MVRET) - VAC123_AMUX_ACM.GetMeasResult(site, MVRET);
        im1[site] = -FPVI0.GetMeasResult(site, MIRET);  // Buck 负电流 → 取反为幅值
    }
    FPVI0.Set(FI, -3.0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // 3A 点
    delay_ms(2);
    VDM_SDA_ACM.MeasureVI(50, 5);
    VAC123_AMUX_ACM.MeasureVI(50, 5);
    FPVI0.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vcs3[site] = VDM_SDA_ACM.GetMeasResult(site, MVRET) - VAC123_AMUX_ACM.GetMeasResult(site, MVRET);
        im3[site] = -FPVI0.GetMeasResult(site, MIRET);
    }
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_ms(1);
    FOR_EACH_VALID_SITE(site)
    {
        if (im3[site] - im1[site] > 1e-6)
            gain[site] = (vcs3[site] - vcs1[site]) / (im3[site] - im1[site]) * 1e3;  // mohm
        else
            gain[site] = ERROR_RES;
    }

    // ====== Step 5: Power Off (三步下电, 同 TM700) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        IBUS_SNS_GAIN->SetTestResult(site, 0, gain[site]);
    }
    return 0;
}

// =====================================================================
// TM702: IBUS_SNS_GAIN_TRIM — IBUS sense Gain trim (Boost, 两点做差)
// DFT: boost mode, chop disable, force PMID2VBUS 1A/3A, measure ATEST0, gain=(deltaV@3A-deltaV@1A)/2
//   (ATEST1-ATEST0)/ibus 为 sense ratio, sweep trim code make ratio=0.2 (TRIM_IBUS_SNS_GAIN)
//   treg [ibus_sns_gain] Target=198mohm, 6bit=64step (0xF3[7:5] + 0xF4[2:0])
// 电流环 (Boost): FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); iset[vbus,1/3] → FPVI0.Set(FI, +1/+3)
//   measure_ibus_sns_gain: 写 EFUSE_REG_F3/F4 → force 1A/3A → VCS=V(VDM)-V(AMUX), I=|FPVI0 MIRET|
//   Gain = |ΔVCS|/|ΔI|×1e3 (mohm) → target 198
// 寄存器 (tm702.sv): 0x09=0x0A(BUBO_MODE=1) 0x10=0x43 0x57=0x06 0x58=0x07 0x5E=0x19 0x64=0x01(ibus_sns_off_chop=1)
// 参数: IBUS_SNS_GAIN_step0..step63 + pre/post (64 step = treg Table 条目数)
// =====================================================================
DUT_API int TM702_IBUS_SNS_GAIN_TRIM(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBUS_SNS_GAIN_step0 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step0");
    CParam *IBUS_SNS_GAIN_step1 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step1");
    CParam *IBUS_SNS_GAIN_step2 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step2");
    CParam *IBUS_SNS_GAIN_step3 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step3");
    CParam *IBUS_SNS_GAIN_step4 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step4");
    CParam *IBUS_SNS_GAIN_step5 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step5");
    CParam *IBUS_SNS_GAIN_step6 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step6");
    CParam *IBUS_SNS_GAIN_step7 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step7");
    CParam *IBUS_SNS_GAIN_step8 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step8");
    CParam *IBUS_SNS_GAIN_step9 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step9");
    CParam *IBUS_SNS_GAIN_step10 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step10");
    CParam *IBUS_SNS_GAIN_step11 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step11");
    CParam *IBUS_SNS_GAIN_step12 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step12");
    CParam *IBUS_SNS_GAIN_step13 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step13");
    CParam *IBUS_SNS_GAIN_step14 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step14");
    CParam *IBUS_SNS_GAIN_step15 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step15");
    CParam *IBUS_SNS_GAIN_step16 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step16");
    CParam *IBUS_SNS_GAIN_step17 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step17");
    CParam *IBUS_SNS_GAIN_step18 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step18");
    CParam *IBUS_SNS_GAIN_step19 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step19");
    CParam *IBUS_SNS_GAIN_step20 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step20");
    CParam *IBUS_SNS_GAIN_step21 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step21");
    CParam *IBUS_SNS_GAIN_step22 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step22");
    CParam *IBUS_SNS_GAIN_step23 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step23");
    CParam *IBUS_SNS_GAIN_step24 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step24");
    CParam *IBUS_SNS_GAIN_step25 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step25");
    CParam *IBUS_SNS_GAIN_step26 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step26");
    CParam *IBUS_SNS_GAIN_step27 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step27");
    CParam *IBUS_SNS_GAIN_step28 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step28");
    CParam *IBUS_SNS_GAIN_step29 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step29");
    CParam *IBUS_SNS_GAIN_step30 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step30");
    CParam *IBUS_SNS_GAIN_step31 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step31");
    CParam *IBUS_SNS_GAIN_step32 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step32");
    CParam *IBUS_SNS_GAIN_step33 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step33");
    CParam *IBUS_SNS_GAIN_step34 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step34");
    CParam *IBUS_SNS_GAIN_step35 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step35");
    CParam *IBUS_SNS_GAIN_step36 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step36");
    CParam *IBUS_SNS_GAIN_step37 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step37");
    CParam *IBUS_SNS_GAIN_step38 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step38");
    CParam *IBUS_SNS_GAIN_step39 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step39");
    CParam *IBUS_SNS_GAIN_step40 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step40");
    CParam *IBUS_SNS_GAIN_step41 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step41");
    CParam *IBUS_SNS_GAIN_step42 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step42");
    CParam *IBUS_SNS_GAIN_step43 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step43");
    CParam *IBUS_SNS_GAIN_step44 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step44");
    CParam *IBUS_SNS_GAIN_step45 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step45");
    CParam *IBUS_SNS_GAIN_step46 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step46");
    CParam *IBUS_SNS_GAIN_step47 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step47");
    CParam *IBUS_SNS_GAIN_step48 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step48");
    CParam *IBUS_SNS_GAIN_step49 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step49");
    CParam *IBUS_SNS_GAIN_step50 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step50");
    CParam *IBUS_SNS_GAIN_step51 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step51");
    CParam *IBUS_SNS_GAIN_step52 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step52");
    CParam *IBUS_SNS_GAIN_step53 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step53");
    CParam *IBUS_SNS_GAIN_step54 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step54");
    CParam *IBUS_SNS_GAIN_step55 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step55");
    CParam *IBUS_SNS_GAIN_step56 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step56");
    CParam *IBUS_SNS_GAIN_step57 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step57");
    CParam *IBUS_SNS_GAIN_step58 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step58");
    CParam *IBUS_SNS_GAIN_step59 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step59");
    CParam *IBUS_SNS_GAIN_step60 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step60");
    CParam *IBUS_SNS_GAIN_step61 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step61");
    CParam *IBUS_SNS_GAIN_step62 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step62");
    CParam *IBUS_SNS_GAIN_step63 = StsGetParam(funcindex, "IBUS_SNS_GAIN_step63");
    CParam *IBUS_SNS_GAIN_pre_value = StsGetParam(funcindex, "IBUS_SNS_GAIN_pre_value");
    CParam *IBUS_SNS_GAIN_pre_bit = StsGetParam(funcindex, "IBUS_SNS_GAIN_pre_bit");
    CParam *IBUS_SNS_GAIN_post_bit = StsGetParam(funcindex, "IBUS_SNS_GAIN_post_bit");
    CParam *IBUS_SNS_GAIN_updated = StsGetParam(funcindex, "IBUS_SNS_GAIN_updated");
    CParam *IBUS_SNS_GAIN_guessed = StsGetParam(funcindex, "IBUS_SNS_GAIN_guessed");
    CParam *IBUS_SNS_GAIN_target = StsGetParam(funcindex, "IBUS_SNS_GAIN_target");
    CParam *IBUS_SNS_GAIN_post_value = StsGetParam(funcindex, "IBUS_SNS_GAIN_post_value");
    CParam *IBUS_SNS_GAIN_post_rt = StsGetParam(funcindex, "IBUS_SNS_GAIN_post_rt");
    //}}AFX_STS_PARAM_PROTOTYPES

    TRIM_NODE &IBUS_SNS_GAIN = trim_reg.trim("ibus_sns_gain");

    // ====== Step 1: Connect (继电器闭合, Boost 电流环) ======
    // 电流环: FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); ATEST1→AMUX(K20); ATEST0→VDM(K59 NC)
    // 供电 cap: VBAT(K13) + PMID(K85)
    cbite.SetOn(K_FPVIH_TO_PMID_A, K_FPVIL_TO_DRVH1_A, K20_ACM0_AMUX, K13_VBAT_Cap, K85_CAP_PMID, -1);
    delay_ms(3);

    // ====== Step 2: Power On (Boost: VBAT=4.4V, PMID=5V) ======
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // 先固定 PMID-VBUS 差分 0
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID=5V, VBUS 跟随
    delay_us(200);
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);      // ATEST0→VDM 高阻读
    VAC123_AMUX_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);  // ATEST1→AMUX 高阻读
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);  // 断开 FXVIe 防挂载
    delay_ms(1);

    // ====== Step 3: Register Config (tm702.sv: 双 pad + BUBO_MODE=1 + off_chop=1) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x09, 0x0A);  // BUBO_MODE=1 (Boost)
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // EN_ATEST0 + EN_ATEST1
    I2CWriteSameData(DEV_ADDR, 0x58, 0x07);  // ATEST1_MUX=7 → IBUS_SNS_BASE
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x19);  // ATEST0_MUX=25 → IBUS_SNS_FB
    I2CWriteSameData(DEV_ADDR, 0x64, 0x01);  // ibus_sns_off_chop=1 (Trim 关 chopping 取稳定 DC)
    delay_ms(2);

    // ====== Step 4: Trim execute (measure_ibus_sns_gain: force 1A/3A 两点做差 → mohm, target 198) ======
    IBUS_SNS_GAIN.execute(measure_ibus_sns_gain, spec, funcindex, funclabel, 1, 0, 0, 0);

    // ====== Step 5: Power Off (Boost 三步下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);  // VBUS=PMID=5V
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // PMID→0, VBUS 跟随
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    return 0;
}

// =====================================================================
// TM703: IBUS_SNS_VOS_TRIM — IBUS sense offset trim (Boost, 单点 2A)
// DFT: IBUS sense vos; trim while chopper off=1; finsh TM702 first, then pull 2A from VBUS
//   Vos = (ATEST0-ATEST1) - 2*0.2 → target 0mV (即 VCS trim 到最接近 2A×0.2=0.4V)
//   treg [ibus_sns_ea_os] Target=0mV, 4bit=16step (0xF3[4:1])
// 电流环 (Boost): FPVI0 High→PMID(K83) + Low→VBUS(K3,K4); iset[vbus,2] → FPVI0.Set(FI, +2)
//   measure_ibus_sns_ea_os: 写 EFUSE_REG_F3 → force 2A → VCS=V(VDM)-V(AMUX), I=|FPVI0 MIRET|
//   Vos = (VCS - I×0.2)×1e3 (mV) → target 0
// 寄存器 (tm703.sv): 0x09=0x0A(BUBO_MODE=1) 0x10=0x43 0x57=0x06 0x58=0x07 0x5E=0x19 0x64=0x01(ibus_sns_off_chop=1)
// 参数: IBUS_SNS_EA_OS_step0..step15 + pre/post (16 step = treg Table 条目数)
// =====================================================================
DUT_API int TM703_IBUS_SNS_VOS_TRIM(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBUS_SNS_EA_OS_step0 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step0");
    CParam *IBUS_SNS_EA_OS_step1 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step1");
    CParam *IBUS_SNS_EA_OS_step2 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step2");
    CParam *IBUS_SNS_EA_OS_step3 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step3");
    CParam *IBUS_SNS_EA_OS_step4 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step4");
    CParam *IBUS_SNS_EA_OS_step5 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step5");
    CParam *IBUS_SNS_EA_OS_step6 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step6");
    CParam *IBUS_SNS_EA_OS_step7 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step7");
    CParam *IBUS_SNS_EA_OS_step8 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step8");
    CParam *IBUS_SNS_EA_OS_step9 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step9");
    CParam *IBUS_SNS_EA_OS_step10 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step10");
    CParam *IBUS_SNS_EA_OS_step11 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step11");
    CParam *IBUS_SNS_EA_OS_step12 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step12");
    CParam *IBUS_SNS_EA_OS_step13 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step13");
    CParam *IBUS_SNS_EA_OS_step14 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step14");
    CParam *IBUS_SNS_EA_OS_step15 = StsGetParam(funcindex, "IBUS_SNS_EA_OS_step15");
    CParam *IBUS_SNS_EA_OS_pre_value = StsGetParam(funcindex, "IBUS_SNS_EA_OS_pre_value");
    CParam *IBUS_SNS_EA_OS_pre_bit = StsGetParam(funcindex, "IBUS_SNS_EA_OS_pre_bit");
    CParam *IBUS_SNS_EA_OS_post_bit = StsGetParam(funcindex, "IBUS_SNS_EA_OS_post_bit");
    CParam *IBUS_SNS_EA_OS_updated = StsGetParam(funcindex, "IBUS_SNS_EA_OS_updated");
    CParam *IBUS_SNS_EA_OS_guessed = StsGetParam(funcindex, "IBUS_SNS_EA_OS_guessed");
    CParam *IBUS_SNS_EA_OS_target = StsGetParam(funcindex, "IBUS_SNS_EA_OS_target");
    CParam *IBUS_SNS_EA_OS_post_value = StsGetParam(funcindex, "IBUS_SNS_EA_OS_post_value");
    CParam *IBUS_SNS_EA_OS_post_rt = StsGetParam(funcindex, "IBUS_SNS_EA_OS_post_rt");
    //}}AFX_STS_PARAM_PROTOTYPES

    TRIM_NODE &IBUS_SNS_EA_OS = trim_reg.trim("ibus_sns_ea_os");

    // ====== Step 1: Connect (继电器闭合, Boost 电流环, 同 TM702) ======
    cbite.SetOn(K_FPVIH_TO_PMID_A, K_FPVIL_TO_DRVH1_A, K20_ACM0_AMUX, K13_VBAT_Cap, K85_CAP_PMID, -1);
    delay_ms(3);

    // ====== Step 2: Power On (Boost: VBAT=4.4V, PMID=5V) ======
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4.4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    AMUX_PGND_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    delay_ms(1);

    // ====== Step 3: Register Config (tm703.sv: 双 pad + BUBO_MODE=1 + off_chop=1) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x09, 0x0A);  // BUBO_MODE=1 (Boost)
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // EN_ATEST0 + EN_ATEST1
    I2CWriteSameData(DEV_ADDR, 0x58, 0x07);  // ATEST1_MUX=7 → IBUS_SNS_BASE
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x19);  // ATEST0_MUX=25 → IBUS_SNS_FB
    I2CWriteSameData(DEV_ADDR, 0x64, 0x01);  // ibus_sns_off_chop=1 (Trim 关 chopping)
    delay_ms(2);

    // ====== Step 4: Trim execute (measure_ibus_sns_ea_os: force 2A → Vos mV, target 0) ======
    IBUS_SNS_EA_OS.execute(measure_ibus_sns_ea_os, spec, funcindex, funclabel, 1, 0, 0, 0);

    // ====== Step 5: Power Off (Boost 三步下电) ======
    FPVI0.Set(FI, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    FPVI0.Set(FV, 0, FPVIe_1V, FPVIe_10A, FPVIe_RELAY_ON);
    delay_us(200);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    PMID_HG2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VAC123_AMUX_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    return 0;
}
// =====================================================================
// TM1004: QDT_VTH_COMP — TRIM 阈值比较器 OFFSET (Toggle, VCP ramp + DTEST0/nQON 观测)
// DFT: vset[vbat,4] → en_tm → en_i2c_ctrl + d2a_qdt_en_comp + d2a_qdt_en
//      → Q_PRE_CHG_VOL=3, Q_DET_RATIO=3 → DMUX_SEL=70 + DMUX_EN (DTEST0 直出)
//      → VCP 0→2→0 (升捕 rise / 降捕 fall, 期望阈值=VPRECHARGE/RATIO)
//      → EN_ATEST0+ATEST0_MUX=34 (DFT 第二组冗余观测路径, ATE 取 DTEST0 数字观测)
// 期望: 阈值 = VPRECHARGE/RATIO; 下阈值测试模式加 0.1V 迟滞 (DFT Notes 20260409)
// 闭环: VBAT_PD3_FXVI(FXVIe S3_5) + VCP_SW_ACM(ACM200 S5_8, K61 NC 直连)
//      + NQON_HG1_ACM(ACM200 S5_9, K64 NC 直连) 观测 DTEST0 (TM641/643 同模式)
// =====================================================================
DUT_API int TM1004_QDT_VTH_COMP(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VTH_COMP_Rise = StsGetParam(funcindex, "VTH_COMP_Rise");
    CParam *VTH_COMP_Fall = StsGetParam(funcindex, "VTH_COMP_Fall");
    CParam *VTH_COMP_Hys = StsGetParam(funcindex, "VTH_COMP_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT → VBAT_PD3_FXVI: K8 默认NC直连, 无需SetOn
    // VCP  → VCP_SW_ACM:    K61 默认NC直连, 无需SetOn
    // nQON → NQON_HG1_ACM:  K64 默认NC直连, 无需SetOn
    // K13_VBAT_Cap: VBAT 静态供电稳定 (ramp 源是 VCP, E012/FR-001 VCP 不闭 Cap)
    // K65_nQON_PU: DTEST0 观测上拉 (TM641/643 同)
    cbite.SetOn(K13_VBAT_Cap, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    // vset[vbat,4,100e-6,0] → VBAT=4V FV; 10V量程(≥2×4V), 100MA电流档
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1004.sv) ======
    // en_tm[] → 进入测试模式
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x01);  // en_i2c_ctrl=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x10);  // d2a_qdt_en_comp=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x80);  // d2a_qdt_en=1
    I2CWriteSameData(DEV_ADDR, 0x27, 0x30);  // Q_PRE_CHG_VOL=3
    I2CWriteSameData(DEV_ADDR, 0x28, 0x0C);  // Q_DET_RATIO=3
    I2CWriteSameData(DEV_ADDR, 0x56, 0x46);  // DMUX_SEL=70 → vth_comp 输出
    I2CWriteSameData(DEV_ADDR, 0x57, 0x09);  // DMUX_EN=1 (DTEST0 直出, TM641 同模式)
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 4: Measure (VCP 升+降 ramp 捕 DTEST0/nQON 翻转) ======
    // sv: vset[vcp,2]→vset[vcp,0] = 升(0→2)+降(2→0) 完整循环
    // nQON 读数与 ramp 反向 (TM643 同): 升扫 TRIG_FALLING 捕 rise / 降扫 TRIG_RISING 捕 fall
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };
    test_method.rampv_capv(VCP_SW_ACM, ACM200_10V, ACM200_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0.0, 2.0, 200, 20, 1.65, TRIG_FALLING, vth_r);  // 升扫: rise 阈值
    test_method.rampv_capv(VCP_SW_ACM, ACM200_10V, ACM200_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           2.0, 0.0, 200, 20, 1.65, TRIG_RISING, vth_f);   // 降扫: fall 阈值
    FOR_EACH_VALID_SITE(site)
    {
        rise_result[site] = vth_r[site];
        fall_result[site] = vth_f[site];
    }
    // Hys = Rise - Fall (Toggle 两段式 3 参数; R-HYS: Hys 电压→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (rise_result[site] - fall_result[site]) * 1e3;  // V → mV
    }
    // sv 尾段: EN_ATEST0+ATEST0_MUX=34 (DFT 第二组冗余观测路径, 保留寄存器写)
    I2CWriteSameData(DEV_ADDR, 0x57, 0x0B);  // Write reg 0x57 = 11
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x22);  // EN_ATEST0=1, ATEST0_MUX=34

    // ====== Step 5: Power Off (三步下电) ======
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VTH_COMP_Rise->SetTestResult(site, 0, rise_result[site]);
        VTH_COMP_Fall->SetTestResult(site, 0, fall_result[site]);
        VTH_COMP_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}

// =====================================================================
// TM1006: QDT_ZCD_COMP — 过零比较器精度 (Toggle, VCP ramp + DTEST0/nQON 观测)
// DFT: vset[vbat,4] → en_tm → WAKE_UP → d2a_qdt_en_comp + d2a_qdt_en
//      → DMUX_SEL=71 + DMUX_EN (DTEST0 直出) → VCP -0.5→0.5→-0.5
// 期望: rising 0V / falling ~25mV (过零迟滞)
// 闭环: 同 TM1004 (VBAT_PD3_FXVI + VCP_SW_ACM + NQON_HG1_ACM)
// =====================================================================
DUT_API int TM1006_QDT_ZCD_COMP(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *ZCD_COMP_Rise = StsGetParam(funcindex, "ZCD_COMP_Rise");
    CParam *ZCD_COMP_Fall = StsGetParam(funcindex, "ZCD_COMP_Fall");
    CParam *ZCD_COMP_Hys = StsGetParam(funcindex, "ZCD_COMP_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double rise_result[SITE_NUM] = { 0 };
    double fall_result[SITE_NUM] = { 0 };
    double hys[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合, 同 TM1004) ======
    cbite.SetOn(K13_VBAT_Cap, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1006.sv) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    delay_ms(2);                             // delay[2e-3]
    I2CWriteSameData(DEV_ADDR, 0x57, 0x01);  // en_i2c_ctrl=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x10);  // d2a_qdt_en_comp=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x80);  // d2a_qdt_en=1
    I2CWriteSameData(DEV_ADDR, 0x56, 0x47);  // DMUX_SEL=71 → zcd_comp 输出
    I2CWriteSameData(DEV_ADDR, 0x57, 0x09);  // DMUX_EN=1 (DTEST0 直出)
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 4: Measure (VCP 过零 ramp 捕 DTEST0/nQON 翻转) ======
    // sv: vset[vcp,-0.5]→0.5→-0.5 = 初始-0.5(建位)+升(−0.5→0.5)+降(0.5→−0.5)
    // 升扫 TRIG_FALLING 捕 rise (期望 0V) / 降扫 TRIG_RISING 捕 fall (期望 ~25mV)
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };
    test_method.rampv_capv(VCP_SW_ACM, ACM200_10V, ACM200_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           -0.5, 0.5, 200, 20, 1.65, TRIG_FALLING, vth_r);  // 升扫: rise 过零点
    test_method.rampv_capv(VCP_SW_ACM, ACM200_10V, ACM200_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0.5, -0.5, 200, 20, 1.65, TRIG_RISING, vth_f);   // 降扫: fall 过零点
    FOR_EACH_VALID_SITE(site)
    {
        rise_result[site] = vth_r[site];
        fall_result[site] = vth_f[site];
    }
    // 过零迟滞 Hys = Fall - Rise (falling 阈值高于 rising, 期望 ~25mV; R-HYS V→mV)
    FOR_EACH_VALID_SITE(site)
    {
        hys[site] = (fall_result[site] - rise_result[site]) * 1e3;  // V → mV
    }
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 5: Power Off (三步下电) ======
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_100MA, ACM200_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VCP_SW_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        ZCD_COMP_Rise->SetTestResult(site, 0, rise_result[site]);
        ZCD_COMP_Fall->SetTestResult(site, 0, fall_result[site]);
        ZCD_COMP_Hys->SetTestResult(site, 0, hys[site]);
    }
    return 0;
}

// =====================================================================
// TM1007: QDT_IBP_ZTC_1UA_TEST — IBP 电流 ibias 测试模式 (MI, 测 I(ATEST0))
// DFT: vset[vbat,4] → en_tm → en_i2c_ctrl + d2a_qdt_en → EN_ATEST0+ATEST0_MUX=33
//      → vset[vdm,1] → 测 I(VDM)=I(ATEST0), 期望 1uA
// 闭环: VBAT_PD3_FXVI + VDM_SDA_ACM (TM103 同款)
// =====================================================================
DUT_API int TM1007_QDT_IBP_ZTC_1UA_TEST(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *IBP_ZTC_1UA = StsGetParam(funcindex, "IBP_ZTC_1UA");
    //}}AFX_STS_PARAM_PROTOTYPES

    double ibp_ztc_1ua[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT → VBAT_PD3_FXVI: K8 默认NC直连
    // VDM  → VDM_SDA_ACM:   K59 默认NC直连
    // K13_VBAT_Cap: VBAT 静态供电稳定 (被测电流是 I(VDM), 不流经 VBAT)
    cbite.SetOn(K13_VBAT_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1007.sv) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x01);  // en_i2c_ctrl=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x80);  // d2a_qdt_en=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x03);  // Write reg 0x57 = 3
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x21);  // EN_ATEST0=1, ATEST0_MUX=33

    // ====== Step 4: Measure (VDM=1V FV, 测 I(ATEST0)) ======
    // vset[vdm,1,100e-6,0]: 10UA最小电流档, 量程2x≥1uA (TM103 同款)
    VDM_SDA_ACM.Set(FV, 1, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);                             // delay[1e-3]
    VDM_SDA_ACM.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        ibp_ztc_1ua[site] = VDM_SDA_ACM.GetMeasResult(site, MIRET) * 1e6;  // A → uA (期望 1uA)
    }

    // ====== Step 5: Power Off (三步下电) ======
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        IBP_ZTC_1UA->SetTestResult(site, 0, ibp_ztc_1ua[site]);
    }
    return 0;
}

// =====================================================================
// TM1008: QDT_VREF_VTH_CMP — vth cmp 的 vref (MV, 测 V(ATEST0))
// DFT: vset[vbat,4] → en_tm → en_i2c_ctrl + d2a_qdt_en → EN_ATEST0+ATEST0_MUX=32
//      → VDM 高阻 FI=0, DUT ATEST0 输出驱动 VDM pad, 期望 1.2/16=0.075V
// 闭环: VBAT_PD3_FXVI + VDM_SDA_ACM (TM100 同款)
// =====================================================================
DUT_API int TM1008_QDT_VREF_VTH_CMP(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VREF_VTH_CMP = StsGetParam(funcindex, "VREF_VTH_CMP");
    //}}AFX_STS_PARAM_PROTOTYPES

    double vref_vth_cmp[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    cbite.SetOn(K13_VBAT_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1008.sv) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x01);  // en_i2c_ctrl=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x80);  // d2a_qdt_en=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x03);  // Write reg 0x57 = 3
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x20);  // EN_ATEST0=1, ATEST0_MUX=32

    // ====== Step 4: Measure (VDM 高阻 FI=0 测 V(ATEST0)) ======
    // vset_off[vdm]: DUT 的 ATEST0 输出驱动 VDM pad (TM100 同款)
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);                             // delay[1e-3]
    VDM_SDA_ACM.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vref_vth_cmp[site] = VDM_SDA_ACM.GetMeasResult(site, MVRET);
    }

    // ====== Step 5: Power Off (三步下电) ======
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VREF_VTH_CMP->SetTestResult(site, 0, vref_vth_cmp[site]);
    }
    return 0;
}

// =====================================================================
// TM1009: QDT_VPCHG_SHORT_CURRENT — VPRECHG 最大输出能力 (MI, 测 I(SW1))
// DFT: vset[vbat,4] → en_tm → en_i2c_ctrl + d2a_qdt_en_prechg + d2a_qdt_en
//      → delay 10e-3 → SW1 1.2V→0V → 测 I(SW1), 期望 ~2mA
// 测法: SW1 先 FV=1.2V 建立预充 → FV=0V 强制拉低, DUT 预充 driver 推电流 → 源表测短路电流
// 闭环: VBAT_PD3_FXVI + SW1_SW2_FXVI(FXVIe S3_0, K46/K47 需闭合)
// =====================================================================
DUT_API int TM1009_QDT_VPCHG_SHORT_CURRENT(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VPCHG_SHORT_CURRENT = StsGetParam(funcindex, "VPCHG_SHORT_CURRENT");
    //}}AFX_STS_PARAM_PROTOTYPES

    double vpchg_short_current[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT → VBAT_PD3_FXVI:  K8 默认NC直连
    // SW1  → SW1_SW2_FXVI:   CH0 High→K46 / Low→K47 需闭合
    // K13_VBAT_Cap: VBAT 静态供电稳定
    // K45_Cap_SW1_BST1: SW1 稳压电容 220nF (FR-001: SW1 静态驱动→闭)
    cbite.SetOn(K13_VBAT_Cap, K46_BUS0_FH_SW1, K47_BUS0_FL_SW1, K45_Cap_SW1_BST1, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1009.sv) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x57, 0x01);  // en_i2c_ctrl=1
    I2CWriteSameData(DEV_ADDR, 0x5A, 0x40);  // d2a_qdt_en_prechg=1
    I2CWriteSameData(DEV_ADDR, 0x5B, 0x80);  // d2a_qdt_en=1
    delay_ms(10);                            // delay[10e-3]

    // ====== Step 4: Measure (SW1 1.2V→0V, 测短路电流) ======
    // vset[sw1,1.2]: 预充目标建立; vset[sw1,0]: 强制拉低 → DUT driver 推电流 → 源表测 I(SW1)
    // 期望 ~2mA → 10MA 量程 (≥2×2mA)
    SW1_SW2_FXVI.Set(FV, 1.2, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    SW1_SW2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    SW1_SW2_FXVI.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vpchg_short_current[site] = fabs(SW1_SW2_FXVI.GetMeasResult(site, MIRET)) * 1e3;  // A → mA (期望 ~2mA)
    }
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 5: Power Off (三步下电) ======
    SW1_SW2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    SW1_SW2_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VPCHG_SHORT_CURRENT->SetTestResult(site, 0, vpchg_short_current[site]);
    }
    return 0;
}

// =====================================================================
// TM1100: DEMO_VREF_1P65 — DEMO 参考电压 (MV, 测 V(ATEST0))
// DFT: vset[vbat,4] → en_tm → WAKE_UP → D2A_OVRD_SEL=44 + ovrd_value=3
//      → EN_ATEST0/EN_ATEST1 + ADM_ATEST1_MUX → delay 2e-3 → ADM_ATEST0_MUX=14
//      → VDM 高阻 FI=0 测 V(ATEST0), 期望 1.65V
// 闭环: VBAT_PD3_FXVI + VDM_SDA_ACM (TM100 同款)
// =====================================================================
DUT_API int TM1100_DEMO_VREF_1P65(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VREF_1P65 = StsGetParam(funcindex, "VREF_1P65");
    //}}AFX_STS_PARAM_PROTOTYPES

    double vref_1p65[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    cbite.SetOn(K13_VBAT_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置, reg_config/tm1100.sv) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x67, 0x2C);  // D2A_OVRD_SEL=44
    I2CWriteSameData(DEV_ADDR, 0x68, 0x30);  // ovrd_value=3
    I2CWriteSameData(DEV_ADDR, 0x57, 0x06);  // Write reg 0x57 = 6
    I2CWriteSameData(DEV_ADDR, 0x5D, 0x70);  // EN_ATEST0=1, EN_ATEST1=1, ADM_ATEST1_MUX=1/7+H
    delay_ms(2);                             // delay[2e-3]
    I2CWriteSameData(DEV_ADDR, 0x5D, 0x7E);  // ADM_ATEST0_MUX=14
    delay_ms(2);                             // delay[2e-3]

    // ====== Step 4: Measure (VDM 高阻 FI=0 测 V(ATEST0)) ======
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VDM_SDA_ACM.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vref_1p65[site] = VDM_SDA_ACM.GetMeasResult(site, MVRET);
    }

    // ====== Step 5: Power Off (三步下电) ======
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        VREF_1P65->SetTestResult(site, 0, vref_1p65[site]);
    }
    return 0;
}

// =====================================================================
// TM1205: TRX_BST_UV_GD — BST1-SW1 / BST2-SW2 两组 BST UVLO 阈值 (Toggle)
// DFT OVERVIEW (Dali_testmode.xlsx): Test BST1-SW1, BST2-SW2 的 UVLO 值
//   流程: vbat=4V → en_tm → D2A_OVRD_SEL 47/45/48=3 + BOOTGD_DEG_BYPASS
//         → DMUX_SEL=57(路1 BST1-SW1) 双扫 → DMUX_SEL=58(路2 BST2-SW2) 双扫
// 驱动: BST1/BST2 为自举高侧、SW1/SW2 为开关低侧 → V(BST) > V(SW)
//   FPVI0 浮动差分跨对: High→SW(K46/K49), Low→BST(K41/K43)
//   FPVI0 输出 = V(SW)-V(BST) = -(BST-SW 压差) ∈ [-4,0]V
//   ramp 0→-4V ⟺ BST-SW 0→4V (上扫, 释放) / -4→0V ⟺ 4→0V (下扫, UVLO 触发)
// 观测: nQON(DTEST0) 翻转 (TM641/643 同模式), 继电器 K65_nQON_PU 上拉
// 两路串行: FPVI0 单通道, 先 DMUX 57 测 BST1-SW1, 再切 K43/K49 + DMUX 58 测 BST2-SW2
// =====================================================================
DUT_API int TM1205_TRX_BST_UV_GD(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *BST1_UV_Rise = StsGetParam(funcindex, "BST1_UV_Rise");
    CParam *BST1_UV_Fall = StsGetParam(funcindex, "BST1_UV_Fall");
    CParam *BST1_UV_Hys = StsGetParam(funcindex, "BST1_UV_Hys");
    CParam *BST2_UV_Rise = StsGetParam(funcindex, "BST2_UV_Rise");
    CParam *BST2_UV_Fall = StsGetParam(funcindex, "BST2_UV_Fall");
    CParam *BST2_UV_Hys = StsGetParam(funcindex, "BST2_UV_Hys");
    //}}AFX_STS_PARAM_PROTOTYPES

    double bst1_rise[SITE_NUM] = { 0 };
    double bst1_fall[SITE_NUM] = { 0 };
    double bst1_hys[SITE_NUM] = { 0 };
    double bst2_rise[SITE_NUM] = { 0 };
    double bst2_fall[SITE_NUM] = { 0 };
    double bst2_hys[SITE_NUM] = { 0 };
    double vth_r[SITE_NUM] = { 0 };
    double vth_f[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // 路1 BST1-SW1: FPVI0 High→SW1 (K_FPVIH_TO_SW1_A=K46) + FPVI0 Low→BST1 (K_FPVIL_TO_BST1_A=K41)
    //   K46/K41 均为 Relay-ON 需闭合; BST1/SW1 Kelvin 对
    // VBAT 静态供电: K13_VBAT_Cap; nQON 观测: K65_nQON_PU 上拉
    // ⚠ Cap 纪律 (FR-001): BST-SW 是差分 ramp 源 → 不闭 BST Cap (K45_Cap_SW1_BST1/K44_Cap_SW2_BST2 拖慢 ramp)
    cbite.SetOn(K_FPVIH_TO_SW1_A, K_FPVIL_TO_BST1_A, K13_VBAT_Cap, K65_nQON_PU, -1);
    delay_ms(3);

    // ====== Step 2: Power On (VBAT 台阶, DFT: vbat=4V) ======
    // FPVI0 先 0 差分 (SW1=BST1), VBAT 上电后 FPVI0 输出负域 ramp
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);  // 差分 0: BST1-SW1=0V
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);  // VBAT=4V
    delay_ms(1);

    // ====== Step 3: Register Config (tm1205.sv 权威序列) ======
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);  // WAKE_UP=1
    I2CWriteSameData(DEV_ADDR, 0x67, 0x2F);  I2CWriteSameData(DEV_ADDR, 0x68, 0x30);  // D2A_OVRD_SEL=47, ovrd=3
    I2CWriteSameData(DEV_ADDR, 0x67, 0x2D);  I2CWriteSameData(DEV_ADDR, 0x68, 0x30);  // D2A_OVRD_SEL=45, ovrd=3
    I2CWriteSameData(DEV_ADDR, 0x67, 0x30);  I2CWriteSameData(DEV_ADDR, 0x68, 0x30);  // D2A_OVRD_SEL=48, ovrd=3
    I2CWriteSameData(DEV_ADDR, 0x5C, 0x02);  // D2A_TRX_TM_BOOTGD_DEG_BYPASS=1
    delay_ms(1);                             // delay[1e-3]

    // ====== Step 4: Measure (两路串行, 各 Toggle 双扫捕 nQON 翻转) ======
    // 路1: BST1-SW1 (DMUX_SEL=57)
    I2CWriteSameData(DEV_ADDR, 0x56, 0x39);  // DMUX_SEL=57
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    delay_us(100);
    // FPVI0 输出 0→-4V = BST1-SW1 0→4V 上扫: 释放阈值 (nQON 与 ramp 反向, TRIG_FALLING 捕 rise)
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0, -4, 200, 20, 1.65, TRIG_FALLING, vth_r);
    // FPVI0 输出 -4→0V = BST1-SW1 4→0V 下扫: UVLO 触发阈值 (TRIG_RISING 捕 fall)
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           -4, 0, 200, 20, 1.65, TRIG_RISING, vth_f);
    FOR_EACH_VALID_SITE(site)
    {
        bst1_rise[site] = fabs(vth_r[site]);   // |FPVIe 触发点| = BST1-SW1 压差
        bst1_fall[site] = fabs(vth_f[site]);
    }
    FOR_EACH_VALID_SITE(site)
    {
        bst1_hys[site] = (bst1_rise[site] - bst1_fall[site]) * 1e3;  // V→mV (R-HYS)
    }
    delay_ms(1);

    // 路2: BST2-SW2 (重新 SetOn 切路: K_FPVIH_TO_SW2_A=46,49 + K_FPVIL_TO_BST2_A=41,43; DMUX_SEL=58)
    cbite.SetOn(K_FPVIH_TO_SW2_A, K_FPVIL_TO_BST2_A, K13_VBAT_Cap, K65_nQON_PU, -1);
    delay_ms(3);
    I2CWriteSameData(DEV_ADDR, 0x56, 0x3A);  // DMUX_SEL=58
    I2CWriteSameData(DEV_ADDR, 0x57, 0x08);  // DMUX_EN=1
    delay_us(100);
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           0, -4, 200, 20, 1.65, TRIG_FALLING, vth_r);
    test_method.rampv_capv(FPVI0, FPVIe_10V, FPVIe_100MA,
                           NQON_HG1_ACM, ACM200_10V, ACM200_10UA,
                           -4, 0, 200, 20, 1.65, TRIG_RISING, vth_f);
    FOR_EACH_VALID_SITE(site)
    {
        bst2_rise[site] = fabs(vth_r[site]);
        bst2_fall[site] = fabs(vth_f[site]);
    }
    FOR_EACH_VALID_SITE(site)
    {
        bst2_hys[site] = (bst2_rise[site] - bst2_fall[site]) * 1e3;
    }
    delay_ms(1);

    // ====== Step 5: Power Off ======
    FPVI0.Set(FV, 0, FPVIe_5V, FPVIe_100MA, FPVIe_RELAY_ON);   // 差分回 0
    delay_us(200);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    FPVI0.Set(FV, 0, FPVIe_10V, FPVIe_10MA, FPVIe_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    NQON_HG1_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData ======
    FOR_EACH_VALID_SITE(site)
    {
        BST1_UV_Rise->SetTestResult(site, 0, bst1_rise[site]);
        BST1_UV_Fall->SetTestResult(site, 0, bst1_fall[site]);
        BST1_UV_Hys->SetTestResult(site, 0, bst1_hys[site]);
        BST2_UV_Rise->SetTestResult(site, 0, bst2_rise[site]);
        BST2_UV_Fall->SetTestResult(site, 0, bst2_fall[site]);
        BST2_UV_Hys->SetTestResult(site, 0, bst2_hys[site]);
    }
    return 0;
}
