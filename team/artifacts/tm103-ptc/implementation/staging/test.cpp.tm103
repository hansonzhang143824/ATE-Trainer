// =====================================================================
// TM421: VBUS_FB — VBUS 反馈电压 (FB, ATEST0 MV via VDM)
// DFT: vset[vbat,4,100e-6,0] -> en_tm[] -> 0x10=0x43, 0x11=0x14, 0x57=0x02, 0x5E=0x1F (ATEST0_MUX=31=channel voutp) -> vset[vbus,4,1e-3,1] -> vset[vbus,10,1e-3,1], 测 V(ATEST0)=VBUS/10
// 期望: VBUS/10 = 1.0V
// Loop: VBAT_PD3_FXVI + VBUS_DRVH1_ACM + VDM_SDA_ACM
// =====================================================================
DUT_API int TM421_VBUS_FB(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *VBUS_FB = StsGetParam(funcindex, "VBUS_FB");
    //}}AFX_STS_PARAM_PROTOTYPES

    double vbus_fb[SITE_NUM] = { 0 };

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT -> VBAT_PD3_FXVI: K8 default NC
    // VBUS -> VBUS_DRVH1_ACM: default NC (VBUS 静态供电, 测 ATEST0 不流经其 Cap)
    // VDM  -> VDM_SDA_ACM: K59 default NC=VDM
    // K13_VBAT_Cap + K5_VBUS_Cap: VBAT/VBUS 静态供电稳定 (FR-001: 供电→闭)
    cbite.SetOn(K13_VBAT_Cap, K5_VBUS_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    // vset[vbat,4,100e-6,0] -> VBAT=4V FV; vset[vbus,4,1e-3,1] -> vset[vbus,10,1e-3,1] -> VBUS=10V
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VBUS_DRVH1_ACM.Set(FV, 4, ACM200_40V, ACM200_100MA, ACM200_RELAY_ON);
    delay_ms(1);
    VBUS_DRVH1_ACM.Set(FV, 10, ACM200_40V, ACM200_100MA, ACM200_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // 0x10=0x43(WAKE_UP); 0x11=0x14(AMUX 通道=VBUS); 0x57=0x02(EN_ATEST0); 0x5E=0x1F(ATEST0_MUX=31=channel voutp)
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);
    I2CWriteSameData(DEV_ADDR, 0x11, 0x14);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x02);
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x1F);
    delay_ms(2);

    // ====== Step 4: Measure (VDM 高阻 MV 测 ATEST0 = channel voutp) ======
    // VDM_SDA_ACM.Set(FI, 0, 10V, 10UA) 高阻: DUT ATEST0 输出驱动 VDM pad
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VDM_SDA_ACM.MeasureVI(50, 5);
    FOR_EACH_VALID_SITE(site)
    {
        vbus_fb[site] = VDM_SDA_ACM.GetMeasResult(site, MVRET);
    }

    // ====== Step 5: Power Off (三步下电) ======
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_40V, ACM200_100MA, ACM200_RELAY_ON);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    VBUS_DRVH1_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);
    VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    // ====== Step 6: LogData (测试结果) ======
    FOR_EACH_VALID_SITE(site)
    {
        VBUS_FB->SetTestResult(site, 0, vbus_fb[site]);
    }
    return 0;
}

// =====================================================================
// TM422: VBAT_FB — VBAT 反馈电压 trim (Trim, mnt_vbat_rsns_loop)
// DFT: vset[vbat,4,100e-6,0] -> en_tm[] -> 0x10=0x43, 0x57=0x02, 0x5E=0x17 (ATEST0_MUX=23=FB_VBAT) -> vset[vbat,5,100e-6,0]; mnt_vbat_rsns_loop 16步(EFUSE F7 bits1-4), target=0 (FB 偏差)
// 期望: V(FB_VBAT)=VBAT*2/5=2V, trim 使偏差→0
// Loop: VBAT_PD3_FXVI + VDM_SDA_ACM
// =====================================================================
DUT_API int TM422_VBAT_FB(short funcindex, LPCTSTR funclabel)
{
    //{{AFX_STS_PARAM_PROTOTYPES
    CParam *MNT_VBAT_RSNS_LOOP_step0 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step0");
    CParam *MNT_VBAT_RSNS_LOOP_step1 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step1");
    CParam *MNT_VBAT_RSNS_LOOP_step2 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step2");
    CParam *MNT_VBAT_RSNS_LOOP_step3 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step3");
    CParam *MNT_VBAT_RSNS_LOOP_step4 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step4");
    CParam *MNT_VBAT_RSNS_LOOP_step5 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step5");
    CParam *MNT_VBAT_RSNS_LOOP_step6 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step6");
    CParam *MNT_VBAT_RSNS_LOOP_step7 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step7");
    CParam *MNT_VBAT_RSNS_LOOP_step8 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step8");
    CParam *MNT_VBAT_RSNS_LOOP_step9 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step9");
    CParam *MNT_VBAT_RSNS_LOOP_step10 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step10");
    CParam *MNT_VBAT_RSNS_LOOP_step11 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step11");
    CParam *MNT_VBAT_RSNS_LOOP_step12 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step12");
    CParam *MNT_VBAT_RSNS_LOOP_step13 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step13");
    CParam *MNT_VBAT_RSNS_LOOP_step14 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step14");
    CParam *MNT_VBAT_RSNS_LOOP_step15 = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_step15");
    CParam *MNT_VBAT_RSNS_LOOP_pre_value = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_pre_value");
    CParam *MNT_VBAT_RSNS_LOOP_pre_bit = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_pre_bit");
    CParam *MNT_VBAT_RSNS_LOOP_post_bit = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_post_bit");
    CParam *MNT_VBAT_RSNS_LOOP_updated = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_updated");
    CParam *MNT_VBAT_RSNS_LOOP_guessed = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_guessed");
    CParam *MNT_VBAT_RSNS_LOOP_target = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_target");
    CParam *MNT_VBAT_RSNS_LOOP_post_value = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_post_value");
    CParam *MNT_VBAT_RSNS_LOOP_post_rt = StsGetParam(funcindex, "MNT_VBAT_RSNS_LOOP_post_rt");
    //}}AFX_STS_PARAM_PROTOTYPES

    TRIM_NODE &MNT_VBAT_RSNS_LOOP = trim_reg.trim("mnt_vbat_rsns_loop");

    // ====== Step 1: Connect (继电器闭合) ======
    // VBAT -> VBAT_PD3_FXVI: K8 default NC
    // VDM  -> VDM_SDA_ACM: K59 default NC=VDM
    // K13_VBAT_Cap: VBAT 静态供电稳定 (FR-001: 供电→闭)
    cbite.SetOn(K13_VBAT_Cap, -1);
    delay_ms(3);

    // ====== Step 2: Power On (上电) ======
    // vset[vbat,4,100e-6,0] -> VBAT=4V FV (配置寄存器前)
    VBAT_PD3_FXVI.Set(FV, 4, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);

    // ====== Step 3: Register Config (寄存器配置) ======
    // 0x10=0x43(WAKE_UP); 0x57=0x02(EN_ATEST0); 0x5E=0x17(ATEST0_MUX=23=FB_VBAT)
    entertestmode();
    I2CWriteSameData(DEV_ADDR, 0x10, 0x43);
    I2CWriteSameData(DEV_ADDR, 0x57, 0x02);
    I2CWriteSameData(DEV_ADDR, 0x5E, 0x17);
    delay_ms(2);

    // ====== Step 4: Trim execute (measure 写 EFUSE + VDM MV) ======
    // vset[vbat,5,100e-6,0] -> VBAT=5V (测量条件)
    VBAT_PD3_FXVI.Set(FV, 5, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    delay_ms(1);
    // VDM_SDA_ACM.Set(FI, 0, 10V, 10UA) 高阻: DUT ATEST 输出驱动 VDM pad
    VDM_SDA_ACM.Set(FI, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
    MNT_VBAT_RSNS_LOOP.execute(measure_mnt_vbat_rsns_loop, spec, funcindex, funclabel, 1, 0, 0, 0);

    // ====== Step 5: Power Off (三步下电) ======
        VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_100MA, FXVIe_PLUS_RELAY_ON);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10UA, ACM200_RELAY_ON);
    delay_ms(1);
        VBAT_PD3_FXVI.Set(FV, 0, FXVIe_PLUS_10V, FXVIe_PLUS_10MA, FXVIe_PLUS_RELAY_OFF);
    VDM_SDA_ACM.Set(FV, 0, ACM200_10V, ACM200_10MA, ACM200_RELAY_OFF);

    return 0;
}

