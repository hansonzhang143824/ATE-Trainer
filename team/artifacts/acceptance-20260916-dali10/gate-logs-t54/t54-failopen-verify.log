=== ② derive_targets 的筛选条件（L96-114）===
  L96   targets = []
  L97   for fn in functions:
  L98   name = fn.get('name') or ''
  L99   block = fn.get('block') or ''
  L100  if not name or not re.search(r'\brampi_capv\s*\(', block):
  L101  continue
  L102  rm = re.search(r'\brampi_capv\s*\([^;]*?FPVIe_(2A|10A)', block)
  L103  irange = 'FPVIe_%s' % rm.group(1) if rm else 'FPVIe_2A'
  L104  seton = re.search(r'cbite\.SetOn\((.*?)\);', block, re.DOTALL)
  L105  so = seton.group(1) if seton else ''
  L106  if 'K_FPVIH_TO_PGND' in so:
  L107  topo = 'LS'
  L108  elif 'K_FPVIH_TO_PMID' in so:
  L109  topo = 'HS'
  L110  else:
  L111  print('[warn] %s: 含 rampi_capv 但 SetOn 判不出 LS/HS 拓扑 → 跳过（不猜）' % name)
  L112  continue
  L113  targets.append((name, topo, irange))
  L114  return targets

