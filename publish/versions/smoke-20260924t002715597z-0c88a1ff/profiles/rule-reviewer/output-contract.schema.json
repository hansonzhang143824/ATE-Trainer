{
  "type": "object",
  "required": ["tm", "reviewVerdict", "findings", "evidence"],
  "properties": {
    "tm": { "type": "string", "minLength": 2 },
    "reviewVerdict": { "type": "string", "enum": ["pass", "fail"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "severity", "statement"],
        "properties": {
          "ruleId": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "warning", "note"] },
          "statement": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
