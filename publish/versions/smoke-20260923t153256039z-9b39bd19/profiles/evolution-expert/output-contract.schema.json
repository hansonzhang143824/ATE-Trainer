{
  "type": "object",
  "required": ["proposalId", "evidenceBatch", "evidenceArtifacts", "ruleChange", "rationale", "status"],
  "properties": {
    "proposalId": { "type": "string", "minLength": 3 },
    "evidenceBatch": { "type": "string", "minLength": 3 },
    "evidenceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "ruleChange": { "type": "object" },
    "rationale": { "type": "string", "minLength": 20 },
    "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED", "REJECTED"] }
  }
}
