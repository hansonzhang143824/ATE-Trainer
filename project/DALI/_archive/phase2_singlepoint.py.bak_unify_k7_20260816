    for v in sorted(cbit_map.keys()):
        entries = [e for e in cbit_map[v] if e['group'] == group_name]
        if not entries:
            continue
        names = [e['name'] for e in entries]
        merged = merge_names(names)
        if merged in seen:
            # Check if duplicate-cbit alias
            print(f'#define {merged} {v}  // alias, CBIT={v}')
        else:
            print(f'#define {merged} {v}')
        seen.add(merged)
    print()

