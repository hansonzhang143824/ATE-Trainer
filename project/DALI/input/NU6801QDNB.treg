; =============================================================================
; ============================== Bit Fields ===================================
; =============================================================================
; ===                                                                       === 
; ===    Version      =    0x1010                                           ===
; ===       ^                 ^                                             ===
; ===       |                 |                                             ===
; ===   SETTING NAME          |                                             ===
; ===                         |                                             ===
; ===                    SETTING VALUE                                      ===
; ===                binary: b1010 = int 10                                 ===
; ===                int:     1010 = int 1010                               ===
; ===                hex:   0x1010 = int 4112                               ===
; ===                                                                       === 
; =============================================================================
[*SELECTIONS]
ibus_off_term_flt   =b0
                                  ;0 : option to select terminal filter disable
                                 ;1 : option to select terminal filter enable

addr_trim   =b0
                                  ;0 : option to select addr_trim disable
                                 ;1 :  option to select addr_trim enable

part_id_trim   =b0
                                  ;0 : option to select part_id_trim disable
                                 ;1 : option to select part_id_trim enable


; =============================================================================
; ==============================  Build Words  ================================
; =============================================================================
; ===                                                                       === 
; ===   0:             bandgap       =         !                  1         ===
; ===   ^                ^                     ^                  ^         ===
; ===   |                |                     |                  |         ===                            
; === BIT POS in REG     |                     |                  |         ===
; ===                    |                     |                  |         ===
; ===          PARAMETER or SETTING NAME       |                  |         ===
; ===                                           |                  |         === 
; ===                        INVERT BIT (if '!' is present)       |         ===
; ===                                                                       ===
; ===                                     BIT POS in PARAMETER or SETTING   ===
; ===                                                                       ===
; =============================================================================

[_EFUSE_REG_F0]
0:  bandgap		             = 0
1:  bandgap		             = 1
2:  bandgap		             = 2
3:  bandgap		             = 3
4:  iztc_res		                 = 0
5:  iztc_res		                 = 1
6:  iztc_res		                 = 2
7:  iztc_res		                 = 3

[_EFUSE_REG_F1]
0:  iztc_res		                 = 4
1:  iztc_res		                 = 5
2:  bg_res_div		         = 0
3:  bg_res_div		         = 1
4:  bg_res_div		         = 2
5:  osc_4p5m		         = 0
6:  osc_4p5m		         = 1
7:  osc_4p5m		         = 2

[_EFUSE_REG_F2]
0:  osc_4p5m		         = 3
1: ibus_sns_ea_os	     = 0
2: ibus_sns_ea_os	     = 1
3: ibus_sns_ea_os	     = 2
4: ibus_sns_ea_os	     = 3
5: ibus_sns_gain		     = 0
6: ibus_sns_gain		     = 1
7: ibus_sns_gain		     = 2

[_EFUSE_REG_F3]
0: ibus_sns_gain		     = 3
1: ibus_sns_gain		     = 4
2: ibus_loop_os	         = 0
3: ibus_loop_os	         = 1
4: ibus_loop_os	         = 2
5: ibus_loop_os	         = 3
6: amux_ea_os		         = 0
7: amux_ea_os		         = 1

[_EFUSE_REG_F4]
0: amux_ea_os		                 = 2
1: amux_ea_os		                 = 3
2: mnt_vbus_ea_os_buck	 = 0
