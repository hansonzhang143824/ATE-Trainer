
; =============================================================================
; ============================== TRIM PARAMETER  ==============================
; =============================================================================
; ===                                                                       ===
; ===   [PARAMETER NAME]                                                    ===
; ===                                                                       ===
; ===   Target          = TRIM TARGET (with unit conversion  eg. u=10e-6 )  ===
; ===   Trim_type       = TRIM TYPE   ("abs", "rel", "min" or "max" )       ===
; ===   Table           = TRIM TABLE  ("*0%, -0.362%" or "5mv, *10mV")      ===
; ===                                   ^                      ^            ===
; ===                                   |                      |            ===
; ===             START VALUE ( value copied into working after dut.sot() ) ===
; ===                                                                       ===
; ===   Trim_start_adj  = ADJUST START VALUE ("true" or "false")            ===
; ===                                                                       ===
; =============================================================================

[bandgap]
